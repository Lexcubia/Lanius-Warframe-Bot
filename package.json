{
  "name": "lanius-warframe-bot",
  "private": true,
  "version": "0.0.0",
  "description": "Lanius-Warframe-Bot — Warframe query API with QQ/web clients (monorepo).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lanius/api dev",
    "dev:api": "pnpm --filter @lanius/api dev",
    "build": "pnpm -r --filter @lanius/core --filter @lanius/api-client --filter @lanius/api run build",
    "test": "pnpm -r --filter @lanius/core --filter @lanius/api-client --filter @lanius/api run test",
    "typecheck": "pnpm -r --filter @lanius/core --filter @lanius/api-client --filter @lanius/api run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
