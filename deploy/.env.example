# 复制为 deploy/.env
# 生产密钥必须放在 git 工作树之外（更新代码 / git checkout 不会覆盖）：
#   /opt/lanius/secrets/config.local.yaml
DOMAIN=warframe.example.com
PUBLIC_SITE_BASE_URL=https://warframe.example.com
IMAGE_TAG=v0.0.0
GHCR_IMAGE_PREFIX=ghcr.io/lexcubia/lanius-warframe-bot
LANIUS_CONFIG_FILE=/opt/lanius/secrets/config.local.yaml
# 运行时配置（备案 / 派系映射等）：相对 deploy/ 的路径（非密钥）
LANIUS_RUNTIME_DEFAULT=../config/default
LANIUS_RUNTIME_LOCAL=../config/local
# Bot Playwright Chromium 宿主机目录（先跑 deploy/prepare-playwright.sh）
LANIUS_PLAYWRIGHT_DIR=/opt/lanius/ms-playwright
