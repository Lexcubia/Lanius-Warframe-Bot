# 复制为 deploy/.env（勿提交真实密钥；config.local.yaml 另挂）
DOMAIN=warframe.example.com
PUBLIC_SITE_BASE_URL=https://warframe.example.com
IMAGE_TAG=v0.0.0
GHCR_IMAGE_PREFIX=ghcr.io/lexcubia/lanius-warframe-bot
LANIUS_CONFIG_FILE=./config.local.yaml
# 运行时配置（备案 / 派系映射等）：相对 deploy/ 的路径
LANIUS_RUNTIME_DEFAULT=../config/default
LANIUS_RUNTIME_LOCAL=../config/local
