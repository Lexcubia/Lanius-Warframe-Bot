{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    // fetch / Response / URLSearchParams（客户端包；供 tsup --dts 在无完整 @types/node 时通过）
    "lib": ["ES2022", "DOM"]
