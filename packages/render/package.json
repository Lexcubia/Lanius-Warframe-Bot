{
  "name": "@lanius/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DTO → PNG/WebP card renderer for QQ image replies (Vue + Playwright; shares Lanius visual tokens).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "node ./scripts/preview-card.mjs",
    "build:card-host": "vite build --config vite.card-host.config.ts",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/noto-sans-sc": "^5.2.5",
    "@fontsource/rajdhani": "^5.2.5",
    "@lanius/core": "workspace:*",
    "@lanius/ui": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.51.0",
    "satori": "^0.12.1",
    "vite": "^5.4.21",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
