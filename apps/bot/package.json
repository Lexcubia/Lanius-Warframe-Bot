{
  "name": "@lanius/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Official QQ adapter — callbacks, command pipeline, text/image replies via Lanius API.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@lanius/api": "workspace:*",
    "@lanius/config": "workspace:*",
    "@lanius/logger": "workspace:*",
    "@lanius/render": "workspace:*",
    "@lanius/core": "workspace:*",
    "@lanius/qq-official": "workspace:*",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
