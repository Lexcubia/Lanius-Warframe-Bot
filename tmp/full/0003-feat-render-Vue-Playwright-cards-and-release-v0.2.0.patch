+      badgeFg: '#b8860b',
+    };
+  }
+  if (state === 'envy') {
+    return {
+      ring: '#2fbf7a',
+      track: '#cfe3f0',
+      badgeBg: '#e8faf0',
+      badgeFg: '#1f8f5a',
+    };
+  }
+  return {
+    ring: laniusTokens.color.accent,
+    track: laniusTokens.color.border,
+    badgeBg: '#e8f5fc',
+    badgeFg: laniusTokens.color.brand,
+  };
+}
