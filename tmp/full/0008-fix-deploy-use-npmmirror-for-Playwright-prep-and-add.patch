From 2edcb22dbb80585627726c7357bfed853192e74c Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Sun, 11 Oct 2026 19:02:19 +0800
Subject: [PATCH 08/45] fix(deploy): use npmmirror for Playwright prep and add
 deploy workflow

Cancel stuck in-image Chromium downloads; host prep via registry.npmmirror.com.
---
 .../workflows/prepare-playwright-deploy.yml   | 80 +++++++++++++++++++
 deploy/prepare-playwright.sh                  | 27 ++++---
 2 files changed, 98 insertions(+), 9 deletions(-)
 create mode 100644 .github/workflows/prepare-playwright-deploy.yml

diff --git a/.github/workflows/prepare-playwright-deploy.yml b/.github/workflows/prepare-playwright-deploy.yml
new file mode 100644
index 0000000..fa5eb74
--- /dev/null
+++ b/.github/workflows/prepare-playwright-deploy.yml
@@ -0,0 +1,80 @@
+# 服务器：镜像预装 Playwright Chromium → compose build/up（供 QQ 出图联调）
+
+name: Prepare Playwright and deploy
+
+on:
+  workflow_dispatch:
+    inputs:
+      service:
+        description: '仅重建的 compose 服务（空=全部）'
+        required: false
+        default: ''
+        type: string
+      git_ref:
+        description: '检出的 git ref（分支/tag）'
+        required: false
+        default: 'develop'
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  prepare-and-deploy:
+    name: prepare-playwright-and-deploy
+    if: github.repository == 'Lexcubia/Lanius-Warframe-Bot'
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    environment: production
+    steps:
+      - name: Prepare Playwright (mirror) and deploy over SSH
+        uses: appleboy/ssh-action@v1.2.0
+        with:
+          host: ${{ secrets.DEPLOY_HOST }}
+          username: ${{ secrets.DEPLOY_USER }}
+          key: ${{ secrets.DEPLOY_SSH_KEY }}
+          port: ${{ secrets.DEPLOY_PORT }}
+          command_timeout: 80m
+          script: |
+            set -euo pipefail
+            DEPLOY_DIR='${{ secrets.DEPLOY_PATH }}'
+            REPO_ROOT="$(cd "${DEPLOY_DIR}/.." && pwd)"
+            SECRETS_FILE="${LANIUS_SECRETS_FILE:-/opt/lanius/secrets/config.local.yaml}"
+            REF='${{ inputs.git_ref }}'
+            SERVICE='${{ inputs.service }}'
+            test -f "${SECRETS_FILE}" || { echo "missing ${SECRETS_FILE}"; exit 1; }
+            cd "${REPO_ROOT}"
+            git fetch --tags --force origin
+            git fetch origin "${REF}"
+            git checkout -f "FETCH_HEAD"
+            git log -1 --oneline
+            # 国内镜像预装 Chromium（已装同版本则跳过）
+            export PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST:-https://npmmirror.com/mirrors/playwright}"
+            export NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}"
+            bash "${REPO_ROOT}/deploy/prepare-playwright.sh"
+            PLAYWRIGHT_DIR="${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}"
+            test -n "$(compgen -G "${PLAYWRIGHT_DIR}/chromium-*" || true)" || {
+              echo "prepare-playwright.sh finished but no chromium-* under ${PLAYWRIGHT_DIR}"
+              exit 1
+            }
+            cd "${DEPLOY_DIR}"
+            if [ -f .env ]; then
+              grep -q '^LANIUS_CONFIG_FILE=' .env || echo "LANIUS_CONFIG_FILE=${SECRETS_FILE}" >> .env
+              sed -i "s|^LANIUS_CONFIG_FILE=.*|LANIUS_CONFIG_FILE=${SECRETS_FILE}|" .env
+              grep -q '^LANIUS_PLAYWRIGHT_DIR=' .env || echo "LANIUS_PLAYWRIGHT_DIR=${PLAYWRIGHT_DIR}" >> .env
+              sed -i "s|^LANIUS_PLAYWRIGHT_DIR=.*|LANIUS_PLAYWRIGHT_DIR=${PLAYWRIGHT_DIR}|" .env
+            fi
+            export LANIUS_PLAYWRIGHT_DIR="${PLAYWRIGHT_DIR}"
+            export GHCR_IMAGE_PREFIX='ghcr.io/lexcubia/lanius-warframe-bot'
+            if [ -n "${SERVICE}" ]; then
+              docker compose build "${SERVICE}"
+              docker compose up -d "${SERVICE}"
+            else
+              docker compose build
+              docker compose up -d
+            fi
+            docker compose ps
+            sleep 20
+            docker compose logs bot --tail 80 || true
+            curl -fsS "https://${DOMAIN:-warframe.lexcubia.com}/api/lanius/v1/health" || \
+              curl -fsS "http://127.0.0.1/api/lanius/v1/health"
diff --git a/deploy/prepare-playwright.sh b/deploy/prepare-playwright.sh
index c8fd9f2..03921b7 100644
--- a/deploy/prepare-playwright.sh
+++ b/deploy/prepare-playwright.sh
@@ -1,24 +1,28 @@
 #!/usr/bin/env bash
 # 在生产机预装 Playwright Chromium 到宿主机目录，供 bot 容器只读挂载。
-# Actions `docker compose build` 不再下载浏览器；目录已存在且版本匹配时本脚本也会跳过。
+# 默认走 npmmirror，避免卡在官方 CDN / mcr.microsoft.com。
 #
-# 用法（在服务器上，建议 root 或具备 docker 权限的用户）：
+# 用法：
 #   bash /opt/lanius/repo/deploy/prepare-playwright.sh
 #   LANIUS_PLAYWRIGHT_DIR=/opt/lanius/ms-playwright PLAYWRIGHT_VERSION=1.51.0 bash deploy/prepare-playwright.sh
 
 set -euo pipefail
 
 DIR="${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}"
-# 与 packages/render、prepare-runtime-package 中的 playwright 主版本对齐
 PW_VERSION="${PLAYWRIGHT_VERSION:-1.51.0}"
+# 国内镜像：浏览器二进制（可覆盖）
+PW_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST:-https://npmmirror.com/mirrors/playwright}"
+# Node 基础镜像（可换成国内 registry 上的 node:22-bookworm）
+NODE_IMAGE="${LANIUS_PLAYWRIGHT_NODE_IMAGE:-node:22-bookworm}"
 MARKER="${DIR}/.lanius-playwright-version"
 
 echo "[lanius] Playwright prep → ${DIR} (playwright@${PW_VERSION})"
+echo "[lanius] PLAYWRIGHT_DOWNLOAD_HOST=${PW_DOWNLOAD_HOST}"
+echo "[lanius] NODE_IMAGE=${NODE_IMAGE}"
 
 mkdir -p "${DIR}"
 
 if [[ -f "${MARKER}" ]] && [[ "$(cat "${MARKER}")" == "${PW_VERSION}" ]]; then
-  # 已有 chromium-* 目录则跳过下载
   if compgen -G "${DIR}/chromium-*" > /dev/null; then
     echo "[lanius] already installed (version ${PW_VERSION}), skip download"
     ls -la "${DIR}"
@@ -26,16 +30,21 @@ if [[ -f "${MARKER}" ]] && [[ "$(cat "${MARKER}")" == "${PW_VERSION}" ]]; then
   fi
 fi
 
-echo "[lanius] downloading Chromium via docker (one-time / version bump)…"
-# 使用官方 Playwright 镜像拉浏览器；写入宿主机目录后供 bot 挂载复用
+echo "[lanius] downloading Chromium via docker + npmmirror…"
 docker run --rm \
   -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
+  -e PLAYWRIGHT_DOWNLOAD_HOST="${PW_DOWNLOAD_HOST}" \
+  -e npm_config_registry="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}" \
   -v "${DIR}:/ms-playwright" \
-  "mcr.microsoft.com/playwright:v${PW_VERSION}-jammy" \
-  /bin/bash -lc "npx --yes playwright@${PW_VERSION} install chromium"
+  "${NODE_IMAGE}" \
+  /bin/bash -lc "
+    set -euo pipefail
+    npm install -g \"playwright@${PW_VERSION}\"
+    # 系统依赖装在 bot 运行镜像里；此处只拉浏览器二进制
+    playwright install chromium
+  "
 
 echo "${PW_VERSION}" > "${MARKER}"
-# 容器内常以 root 写入；挂载给 uid 10001（镜像内 lanius）只读即可
 chmod -R a+rX "${DIR}" || true
 
 echo "[lanius] done"
