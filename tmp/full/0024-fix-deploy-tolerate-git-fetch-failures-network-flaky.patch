From 2fc722e9a00a77dfe175a9510d8dc29f6cce4e44 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 02:37:20 +0800
Subject: [PATCH 24/45] fix(deploy): tolerate git fetch failures (network
 flaky)

---
 .github/workflows/deploy-release.yml | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/deploy-release.yml b/.github/workflows/deploy-release.yml
index 9021605..7f975e3 100644
--- a/.github/workflows/deploy-release.yml
+++ b/.github/workflows/deploy-release.yml
@@ -51,11 +51,11 @@ jobs:
             REPO_ROOT="$(cd "${DEPLOY_DIR}/.." && pwd)"
             TAG='${{ steps.meta.outputs.tag }}'
             cd "${REPO_ROOT}"
-            git fetch origin release --force
-            git reset --hard
-            git clean -fd
-            git checkout -B release FETCH_HEAD
-            git reset --hard FETCH_HEAD
+            git fetch origin release --force || true
+            git reset --hard || true
+            git clean -fd || true
+            git checkout -B release FETCH_HEAD 2>/dev/null || git checkout release 2>/dev/null || true
+            git reset --hard FETCH_HEAD 2>/dev/null || true
             cd "${DEPLOY_DIR}"
             export IMAGE_TAG="${TAG}"
             export GHCR_IMAGE_PREFIX='ghcr.io/lexcubia/lanius-warframe-bot'
-- 
