---
 .github/workflows/deploy-release.yml | 30 ++++++++++++++++++++---
 deploy/apply-node-release.sh         | 36 +++-------------------------
 deploy/update-node.sh                | 13 ++++++----
 packages/api/tsconfig.json           |  4 +++-
 4 files changed, 42 insertions(+), 41 deletions(-)

diff --git a/.github/workflows/deploy-release.yml b/.github/workflows/deploy-release.yml
index 8fc31b7..4aae80f 100644
--- a/.github/workflows/deploy-release.yml
+++ b/.github/workflows/deploy-release.yml
@@ -66,12 +66,35 @@ jobs:
           echo "runtime=${{ steps.meta.outputs.runtime }}" >> "$GITHUB_OUTPUT"
           echo "Using REF=${REF} RUNTIME=${{ steps.meta.outputs.runtime }} SHA=$(git rev-parse --short HEAD)"
 
-      - name: Pack source tarball
+      - name: Setup Node and pnpm (prebuild on runner)
+        if: steps.ver.outputs.runtime == 'node'
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Enable pnpm
+        if: steps.ver.outputs.runtime == 'node'
+        run: |
+          corepack enable
+          corepack prepare pnpm@9.15.0 --activate
+
+      - name: Install and build on Actions
+        if: steps.ver.outputs.runtime == 'node'
+        run: |
+          pnpm install --frozen-lockfile
+          pnpm --filter @lanius/render build:card-host
+          pnpm build
+          pnpm --filter @lanius/web build
+          test -f apps/api/dist/index.js
+          test -f apps/bot/dist/index.js
+          test -f apps/web/.output/server/index.mjs
+
+      - name: Pack source + dist tarball
         if: steps.ver.outputs.runtime == 'node'
         run: |
           REF='${{ steps.ver.outputs.ref }}'
           mkdir -p .deploy-pack
-          # 打当前 checkout 树（release 分支），避免仅 checkout 旧 tag 时缺部署脚本
+          # 含 dist / .output / card-host；不含 node_modules（现网再 pnpm install）
           tar \
             --exclude='./.git' \
             --exclude='./.deploy-pack' \
@@ -79,7 +102,6 @@ jobs:
             --exclude='./apps/*/node_modules' \
             --exclude='./packages/*/node_modules' \
             --exclude='./apps/web/.nuxt' \
-            --exclude='./apps/web/.output' \
             --exclude='./config/local' \
             --exclude='./data' \
             -czf ".deploy-pack/lanius-${REF}.tgz" .
@@ -144,6 +166,8 @@ jobs:
             export LANIUS_TARBALL="/opt/lanius/releases/lanius-${REF}.tgz"
             export LANIUS_PLAYWRIGHT_DIR="${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}"
             export NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}"
+            # tarball 已在 Actions 预构建 dist/.output
+            export LANIUS_SKIP_BUILD=1
             bash "${REPO_ROOT}/deploy/apply-node-release.sh" "${REF}"
             journalctl -u lanius-api -u lanius-bot -u lanius-web -n 80 --no-pager 2>&1 || true
             curl -fsS "https://${DOMAIN:-warframe.lexcubia.com}/api/lanius/v1/health" || \
diff --git a/deploy/apply-node-release.sh b/deploy/apply-node-release.sh
index cd01984..54cf311 100755
--- a/deploy/apply-node-release.sh
+++ b/deploy/apply-node-release.sh
@@ -107,42 +107,12 @@ export NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.co
 export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_DIR}"
 export PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST:-https://npmmirror.com/mirrors/playwright}"
 
-# 构建：优先宿主机 pnpm；失败则 Docker Node 镜像构建（机房友好镜像）
+# 安装依赖并（可选）构建。默认 LANIUS_SKIP_BUILD=1：使用 Actions 预构建产物。
 export LANIUS_REPO="${REPO_ROOT}"
 export LANIUS_SKIP_GIT=1
 export LANIUS_SYSTEMCTL=0
-build_ok=0
-if command -v pnpm >/dev/null 2>&1; then
-  if bash "${REPO_ROOT}/deploy/update-node.sh" "${TAG}"; then
-    build_ok=1
-  else
-    echo "[lanius] host pnpm build failed; trying Docker Node image…"
-  fi
-fi
-if [[ "${build_ok}" != "1" ]]; then
-  if ! command -v docker >/dev/null 2>&1; then
-    echo "[lanius] host build failed and docker unavailable" >&2
-    exit 1
-  fi
-  docker pull "${NODE_IMAGE}"
-  docker run --rm \
-    -v "${REPO_ROOT}:/app" \
-    -v "${PLAYWRIGHT_DIR}:/ms-playwright" \
-    -w /app \
-    -e NPM_CONFIG_REGISTRY \
-    -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
-    -e PLAYWRIGHT_DOWNLOAD_HOST \
-    -e LANIUS_SKIP_GIT=1 \
-    -e LANIUS_SYSTEMCTL=0 \
-    -e LANIUS_SKIP_PLAYWRIGHT="${LANIUS_SKIP_PLAYWRIGHT:-0}" \
-    "${NODE_IMAGE}" \
-    bash -lc '
-      set -euo pipefail
-      corepack enable
-      corepack prepare pnpm@9.15.0 --activate
-      bash deploy/update-node.sh "'"${TAG}"'"
-    '
-fi
+export LANIUS_SKIP_BUILD="${LANIUS_SKIP_BUILD:-1}"
+bash "${REPO_ROOT}/deploy/update-node.sh" "${TAG}"
 
 # 安装 systemd（首次）
 if [[ "$(id -u)" -eq 0 ]]; then
diff --git a/deploy/update-node.sh b/deploy/update-node.sh
index 5069d80..104f5e3 100755
--- a/deploy/update-node.sh
+++ b/deploy/update-node.sh
@@ -8,6 +8,7 @@
 # 环境变量（均可选）：
 #   LANIUS_REPO          仓库根（默认本脚本上一级）
 #   LANIUS_SKIP_GIT=1    跳过 git fetch/checkout（树已由 tarball/scp 对齐）
+#   LANIUS_SKIP_BUILD=1  跳过 pnpm build（tarball 已含 dist / .output）
 #   LANIUS_SKIP_PLAYWRIGHT=1  跳过 Playwright 检查/安装
 #   LANIUS_SYSTEMCTL=0   不调用 systemctl（仅构建，便于排障）
 #   LANIUS_HEALTH_URL    健康检查 URL（默认 http://127.0.0.1:8787/v1/health）
@@ -74,10 +75,14 @@ if [[ "${LANIUS_SKIP_PLAYWRIGHT:-0}" != "1" ]]; then
   fi
 fi
 
-# API/Bot dist + card-host；Web 单独 Nuxt build（根 package.json build 不含 web）
-pnpm --filter @lanius/render build:card-host
-pnpm build
-pnpm --filter @lanius/web build
+if [[ "${LANIUS_SKIP_BUILD:-0}" == "1" ]]; then
+  echo "[lanius] LANIUS_SKIP_BUILD=1 — 使用 tarball 内已有 dist/.output"
+else
+  # API/Bot dist + card-host；Web 单独 Nuxt build（根 package.json build 不含 web）
+  pnpm --filter @lanius/render build:card-host
+  pnpm build
+  pnpm --filter @lanius/web build
+fi
 
 if [[ ! -f apps/api/dist/index.js ]]; then
   echo "[lanius] missing apps/api/dist/index.js" >&2
diff --git a/packages/api/tsconfig.json b/packages/api/tsconfig.json
index 47af1ce..f5284bd 100644
--- a/packages/api/tsconfig.json
+++ b/packages/api/tsconfig.json
@@ -3,7 +3,9 @@
   "compilerOptions": {
     "rootDir": "src",
     "outDir": "dist",
-    "noEmit": true
+    "noEmit": true,
+    // fetch / Response / URLSearchParams（客户端包；供 tsup --dts 在无完整 @types/node 时通过）
+    "lib": ["ES2022", "DOM"]
   },
   "include": ["src/**/*.ts"],
   "exclude": ["node_modules", "dist"]
