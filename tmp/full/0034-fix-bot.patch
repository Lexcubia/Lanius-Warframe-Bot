+            />
+            <span v-else class="rot__pct">—</span>
+          </div>
+        </div>
+      </li>
+    </ul>
+  </QqCardShell>
+</template>
+
+<style scoped>
+.rot__meta {
+  margin: 0 0 8px;
+  font-size: 12px;
+  color: var(--lanius-text-muted);
+}
+
+.rot__list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.rot__row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 10px;
+  background: var(--lanius-panel-raised);
+  border: 1px solid var(--lanius-border);
+  border-radius: 10px;
+  min-width: 0;
+}
+
+.rot__body {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.rot__name {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--lanius-text);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.rot__valence {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+
+.rot__el {
+  flex-shrink: 0;
+  font-size: 11px;
+  color: var(--lanius-text-muted);
+  min-width: 2.5em;
+}
+
+.rot__pct {
+  font-size: 11px;
+  color: var(--lanius-text-muted);
+}
+</style>
