+ *
+ * @param message - 说明
+ * @returns HttpError
+ */
+export function notFoundError(message = 'Not found'): HttpError {
+  return new HttpError(404, ErrorCode.NOT_FOUND, message, ErrorMessageKey.NOT_FOUND);
+}
