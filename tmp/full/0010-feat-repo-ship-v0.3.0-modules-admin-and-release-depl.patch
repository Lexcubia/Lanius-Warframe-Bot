diff --git a/packages/ui/src/components/DamageTypeIcon.vue b/packages/ui/src/components/DamageTypeIcon.vue
new file mode 100644
index 0000000..77aa422
--- /dev/null
+++ b/packages/ui/src/components/DamageTypeIcon.vue
@@ -0,0 +1,125 @@
+<script setup lang="ts">
+import type { ValenceElement } from '@lanius/core';
+import { computed, ref, watch } from 'vue';
+
+import { resolveValenceElementIconSrc } from '../lib/valence-element-icon.js';
+
+/**
+ * Valence 元素图标（本地资产）。
+ * 始终占固定尺寸槽位：无元素 / 加载失败时显示占位，保证与有图行对齐。
+ */
+const props = withDefaults(
+  defineProps<{
+    /** 规范元素键；优先于 iconUrl 使用本地打包图 */
+    element?: ValenceElement;
+    /** 可选覆盖 URL；无 element 时使用 */
+    iconUrl?: string;
+    /** 无障碍 alt（如「火焰」） */
+    alt?: string;
+    /** 边长像素 */
+    size?: number;
+    /**
+     * 为 false 时：无元素也不渲染占位（用于可选列完全隐藏）。
+     * 默认 true：凡使用本组件处都留槽位。
+     */
+    placeholder?: boolean;
+  }>(),
+  {
+    alt: '',
+    size: 18,
+    placeholder: true,
+  },
+);
+
+/** 当前是否因加载失败而回退占位 */
+const failed = ref(false);
+
+/**
+ * 最终图标地址：本地元素图优先，其次 API 覆盖 URL。
+ */
+const src = computed(() => {
+  if (props.element) {
+    return resolveValenceElementIconSrc(props.element);
+  }
+  return props.iconUrl;
+});
+
+/**
+ * 是否显示占位槽（无 src 或失败，且允许占位）。
+ */
+const showPlaceholder = computed(
+  () => props.placeholder && (!src.value || failed.value),
+);
+
+watch(src, () => {
+  failed.value = false;
+});
+
+/**
+ * 图片加载失败时改用占位。
+ *
+ * @param _event - error 事件（未使用）
+ * @returns 无返回值
+ */
+function onError(_event: Event): void {
+  failed.value = true;
+}
+</script>
+
+<template>
+  <span
+    v-if="src || placeholder"
+    class="dmg-icon"
+    :class="{ 'dmg-icon--placeholder': showPlaceholder }"
+    :style="{ width: `${size}px`, height: `${size}px` }"
+    :aria-hidden="!alt || showPlaceholder ? true : undefined"
+    :role="alt && src && !failed ? 'img' : undefined"
+    :aria-label="alt && src && !failed ? alt : undefined"
+  >
+    <img
+      v-if="src && !failed"
+      class="dmg-icon__img"
+      :src="src"
+      :alt="alt"
+      :width="size"
+      :height="size"
+      loading="lazy"
+      decoding="async"
+      @error="onError"
+    />
+  </span>
+</template>
+
+<style scoped>
+.dmg-icon {
+  flex-shrink: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  vertical-align: middle;
+  box-sizing: border-box;
+  border-radius: 4px;
+  overflow: hidden;
+}
+
+.dmg-icon--placeholder {
+  border: 1px dashed rgba(62, 78, 110, 0.2);
+  background: rgba(62, 78, 110, 0.04);
+}
+
+.dmg-icon--placeholder::after {
+  content: '';
+  width: 42%;
+  height: 42%;
+  border-radius: 2px;
+  background: rgba(62, 78, 110, 0.14);
+}
+
+.dmg-icon__img {
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  display: block;
+  background: transparent;
+}
+</style>
diff --git a/packages/ui/src/components/FissuresFilters.vue b/packages/ui/src/components/FissuresFilters.vue
new file mode 100644
index 0000000..dee416d
--- /dev/null
+++ b/packages/ui/src/components/FissuresFilters.vue
@@ -0,0 +1,387 @@
+<script setup lang="ts">
+import type { FissureDto, FissureEra, FissurePath } from '@lanius/core';
+import { pickLocalized } from '@lanius/core';
+import { computed } from 'vue';
+
+import {
+  collectMissionTypeOptions,
+  emptyFissureFilter,
+  FISSURE_ERA_ORDER,
+  FISSURE_PATH_ORDER,
+  isFissureFilterActive,
+  toggleFilterValue,
+  type FissureFilterState,
+} from '../lib/filter-fissures.js';
+
+/**
+ * 虚空裂隙三维筛选条：遗物类型 / 任务类型 / 普通·钢铁·九重天。
+ * 空选中表示该维不过滤。
+ */
+const props = defineProps<{
+  /** 当前裂隙列表（用于生成任务类型选项） */
+  fissures: readonly FissureDto[];
+  /** 界面 locale */
+  locale: 'zh' | 'en';
+  /** 当前筛选状态 */
+  modelValue: FissureFilterState;
+  /** 过滤后条数（展示计数） */
+  matchCount?: number;
+}>();
+
+const emit = defineEmits<{
+  'update:modelValue': [value: FissureFilterState];
+}>();
+
+/**
+ * 纪元短标签。
+ */
+const ERA_LABEL: Record<FissureEra, { zh: string; en: string }> = {
+  lith: { zh: '古纪', en: 'Lith' },
+  meso: { zh: '前纪', en: 'Meso' },
+  neo: { zh: '中纪', en: 'Neo' },
+  axi: { zh: '后纪', en: 'Axi' },
+  requiem: { zh: '安魂', en: 'Requiem' },
+  omnia: { zh: '全能', en: 'Omnia' },
+};
+
+/**
+ * 路径档短标签。
+ */
+const PATH_LABEL: Record<FissurePath, { zh: string; en: string }> = {
+  normal: { zh: '普通', en: 'Normal' },
+  steelPath: { zh: '钢铁之路', en: 'Steel Path' },
+  empyrean: { zh: '九重天', en: 'Empyrean' },
+};
+
+/**
+ * 维标题文案。
+ */
+const DIM = {
+  group: { zh: '裂隙筛选', en: 'Fissure filters' },
+  era: { zh: '遗物类型', en: 'Relic' },
+  mission: { zh: '任务类型', en: 'Mission' },
+  path: { zh: '难度 / 星图', en: 'Path' },
+  reset: { zh: '清除筛选', en: 'Clear' },
+  matches: { zh: '条结果', en: 'matches' },
+} as const;
+
+/**
+ * 当前 locale 下的任务类型选项。
+ *
+ * @returns 去重排序后的任务类型 chip
+ */
+const missionOptions = computed(() =>
+  collectMissionTypeOptions(props.fissures, props.locale),
+);
+
+/**
+ * 是否存在活动筛选。
+ *
+ * @returns 任一维非空时为 true
+ */
+const active = computed(() => isFissureFilterActive(props.modelValue));
+
+/**
+ * 取双语短标签。
+ *
+ * @param name - 双语对象
+ * @returns 当前 locale 文案
+ */
+function label(name: { zh: string; en: string }): string {
+  return pickLocalized(name, props.locale);
+}
+
+/**
+ * 更新某一维已选列表。
+ *
+ * @param key - 筛选维字段名
+ * @param next - 新的已选数组
+ * @returns 无返回值
+ */
+function patchDim<K extends keyof FissureFilterState>(
+  key: K,
+  next: FissureFilterState[K],
+): void {
+  emit('update:modelValue', { ...props.modelValue, [key]: next });
+}
+
+/**
+ * 切换遗物纪元选中。
+ *
+ * @param era - 纪元键
+ * @returns 无返回值
+ */
+function toggleEra(era: FissureEra): void {
+  patchDim('eras', toggleFilterValue(props.modelValue.eras, era));
+}
+
+/**
+ * 切换任务类型选中。
+ *
+ * @param key - missionTypeKey
+ * @returns 无返回值
+ */
+function toggleMission(key: string): void {
+  patchDim(
+    'missionTypeKeys',
+    toggleFilterValue(props.modelValue.missionTypeKeys, key),
+  );
+}
+
+/**
+ * 切换路径档选中。
+ *
+ * @param path - 路径档
+ * @returns 无返回值
+ */
+function togglePath(path: FissurePath): void {
+  patchDim('paths', toggleFilterValue(props.modelValue.paths, path));
+}
+
+/**
+ * 清除全部筛选。
+ *
+ * @returns 无返回值
+ */
+function reset(): void {
+  emit('update:modelValue', emptyFissureFilter());
+}
+</script>
+
+<template>
+  <div class="ff" role="group" :aria-label="label(DIM.group)">
+    <div class="ff__row">
+      <span class="ff__dim">{{ label(DIM.era) }}</span>
+      <div class="ff__chips">
+        <button
+          v-for="era in FISSURE_ERA_ORDER"
+          :key="era"
+          type="button"
+          class="ff__chip"
+          :class="{ 'ff__chip--on': modelValue.eras.includes(era) }"
+          :aria-pressed="modelValue.eras.includes(era)"
+          @click="toggleEra(era)"
+        >
+          {{ label(ERA_LABEL[era]) }}
+        </button>
+      </div>
+    </div>
+
+    <div class="ff__row">
+      <span class="ff__dim">{{ label(DIM.mission) }}</span>
+      <div class="ff__chips">
+        <button
+          v-for="opt in missionOptions"
+          :key="opt.key"
+          type="button"
+          class="ff__chip"
+          :class="{ 'ff__chip--on': modelValue.missionTypeKeys.includes(opt.key) }"
+          :aria-pressed="modelValue.missionTypeKeys.includes(opt.key)"
+          @click="toggleMission(opt.key)"
+        >
+          {{ label(opt.label) }}
+        </button>
+        <span v-if="missionOptions.length === 0" class="ff__hint">—</span>
+      </div>
+    </div>
+
+    <div class="ff__row">
+      <span class="ff__dim">{{ label(DIM.path) }}</span>
+      <div class="ff__chips">
+        <button
+          v-for="path in FISSURE_PATH_ORDER"
+          :key="path"
+          type="button"
+          class="ff__chip"
+          :class="[
+            `ff__chip--path-${path}`,
+            { 'ff__chip--on': modelValue.paths.includes(path) },
+          ]"
+          :aria-pressed="modelValue.paths.includes(path)"
+          @click="togglePath(path)"
+        >
+          {{ label(PATH_LABEL[path]) }}
+        </button>
+      </div>
+    </div>
+
+    <div v-if="active || matchCount != null" class="ff__meta">
+      <span v-if="matchCount != null" class="ff__count">
+        {{ matchCount }} {{ label(DIM.matches) }}
