+ * 从 localStorage 恢复开合；无记录时桌面默认开、窄屏默认关。
+ *
+ * @returns 无返回值
+ */
+function restoreOpen(): void {
+  if (!import.meta.client) return;
+  try {
+    const saved = localStorage.getItem(STORAGE_KEY);
+    if (saved === '1' || saved === '0') {
+      navOpen.value = saved === '1';
+      return;
+    }
+  } catch {
+    /* ignore */
+  }
+  navOpen.value = !isMobile();
+}
+
+/**
+ * 持久化开合状态。
+ *
+ * @param open - 是否展开
+ * @returns 无返回值
+ */
+function persistOpen(open: boolean): void {
+  if (!import.meta.client) return;
+  try {
+    localStorage.setItem(STORAGE_KEY, open ? '1' : '0');
+  } catch {
+    /* ignore */
+  }
+}
+
+/**
+ * 打开浮动侧栏。
+ *
+ * @returns 无返回值
+ */
+function openNav(): void {
+  navOpen.value = true;
+  persistOpen(true);
+}
+
+/**
+ * 关闭浮动侧栏（完全收起）。
+ *
+ * @returns 无返回值
+ */
+function closeNav(): void {
+  navOpen.value = false;
+  persistOpen(false);
+}
+
+/**
+ * 窄屏时若打开侧栏则锁滚动，避免背后页面跟着滚。
+ *
+ * @param open - 是否展开
+ * @returns 无返回值
+ */
+function syncBodyScroll(open: boolean): void {
+  if (!import.meta.client) return;
+  document.documentElement.style.overflow =
+    open && isMobile() ? 'hidden' : '';
+}
+
+watch(
+  () => route.fullPath,
+  () => {
+    // 路由变化后保持用户偏好；仅在窄屏默认关时不强制关
+    if (isMobile()) {
+      closeNav();
+    }
+  },
+);
+
+watch(navOpen, (open) => {
+  syncBodyScroll(open);
+});
+
+onMounted(() => {
+  restoreOpen();
+  syncBodyScroll(navOpen.value);
+});
+
+onBeforeUnmount(() => {
+  if (!import.meta.client) return;
+  document.documentElement.style.overflow = '';
+});
 </script>
 
