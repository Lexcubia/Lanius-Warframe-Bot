+import {
+  ModuleIdSchema,
+  type HelpDto,
+  type ModuleId,
+  buildHelpDto,
+  resolveModuleToken,
+} from '@lanius/core';
+
+import type { LaniusDb } from './client.js';
+
+/**
+ * 模块开关行。
+ */
+export type ModuleSettingRow = {
+  module_id: string;
+  enabled: number;
+  sort_order: number;
+  help_override_json: string | null;
+};
+
+/**
+ * ACL 规则行。
+ */
+export type AclRuleRow = {
+  id: number;
+  scope: string;
+  target_id: string;
+  subject: string;
+  effect: string;
+  module_id: string | null;
+  user_openid: string | null;
+  created_at: string;
+};
+
+/**
+ * 审计事件写入入参。
+ */
+export type AuditEventInput = {
+  scene: string;
+  targetId: string;
+  userId: string;
+  moduleId: string;
+  outcome: string;
+  latencyMs: number;
+  requestId: string;
+  detail?: string;
+};
+
+/**
+ * 列出全部模块设置。
+ *
+ * @param db - 数据库
+ * @returns 行列表
+ */
+export function listModuleSettings(db: LaniusDb): ModuleSettingRow[] {
+  return db.all<ModuleSettingRow>(
+    'SELECT module_id, enabled, sort_order, help_override_json FROM module_settings ORDER BY sort_order ASC',
+  );
+}
+
+/**
+ * 更新模块开关。
+ *
+ * @param db - 数据库
+ * @param moduleId - 模块 id
+ * @param enabled - 是否启用
+ * @returns 无返回值
+ */
+export function setModuleEnabled(
+  db: LaniusDb,
+  moduleId: ModuleId,
+  enabled: boolean,
+): void {
+  db.run('UPDATE module_settings SET enabled = ? WHERE module_id = ?', [
+    enabled ? 1 : 0,
+    moduleId,
+  ]);
+}
+
+/**
+ * 启用的模块 id 集合。
+ *
+ * @param db - 数据库
+ * @returns Set
+ */
+export function enabledModuleIdSet(db: LaniusDb): Set<string> {
+  const rows = listModuleSettings(db);
+  return new Set(rows.filter((row) => row.enabled === 1).map((row) => row.module_id));
+}
+
+/**
+ * 从 DB + 目录构建帮助 DTO。
+ *
+ * @param db - 数据库
+ * @param moduleToken - 可选模块 token
+ * @returns HelpDto
+ */
+export function buildHelpFromDb(db: LaniusDb, moduleToken?: string): HelpDto {
+  const enabled = enabledModuleIdSet(db);
+  const moduleId = moduleToken ? resolveModuleToken(moduleToken) : undefined;
+  const base = buildHelpDto({
+    moduleId,
+    enabledIds: enabled,
+  });
+
+  const menu = db.get<{
+    title_zh: string;
+    title_en: string;
+    intro_zh: string;
+    intro_en: string;
+    visible_module_ids_json: string;
+  }>('SELECT * FROM help_menu WHERE id = 1');
+
+  if (!menu || moduleId) {
+    return base;
+  }
+
+  let visible: string[] = [];
+  try {
+    visible = JSON.parse(menu.visible_module_ids_json) as string[];
+  } catch {
+    visible = [...enabled];
+  }
+  const visibleSet = new Set(visible.filter((id) => enabled.has(id)));
+  return {
+    title: { zh: menu.title_zh, en: menu.title_en },
+    intro: { zh: menu.intro_zh, en: menu.intro_en },
+    lines: base.lines.filter((line) => visibleSet.has(line.id)),
+  };
+}
+
+/**
+ * 更新帮助菜单文案与可见模块。
+ *
+ * @param db - 数据库
+ * @param payload - 菜单字段
+ * @returns 无返回值
+ */
+export function updateHelpMenu(
+  db: LaniusDb,
+  payload: {
+    titleZh: string;
+    titleEn: string;
+    introZh: string;
+    introEn: string;
+    visibleModuleIds: string[];
+  },
+): void {
+  db.run(
+    `UPDATE help_menu SET title_zh=?, title_en=?, intro_zh=?, intro_en=?, visible_module_ids_json=?
+     WHERE id = 1`,
+    [
+      payload.titleZh,
+      payload.titleEn,
+      payload.introZh,
+      payload.introEn,
+      JSON.stringify(payload.visibleModuleIds),
+    ],
+  );
+}
+
+/**
+ * 列出 ACL。
+ *
+ * @param db - 数据库
+ * @returns 规则列表
+ */
+export function listAclRules(db: LaniusDb): AclRuleRow[] {
+  return db.all<AclRuleRow>(
+    `SELECT id, scope, target_id, subject, effect, module_id, user_openid, created_at
+     FROM acl_rules ORDER BY id DESC`,
+  );
+}
+
+/**
+ * 新增 ACL 规则。
+ *
+ * @param db - 数据库
+ * @param rule - 规则字段
+ * @returns 新 id
+ */
+export function insertAclRule(
+  db: LaniusDb,
+  rule: {
+    scope: 'global' | 'group' | 'c2c';
+    targetId: string;
+    subject: 'module' | 'user';
+    effect: 'allow' | 'deny';
+    moduleId?: string;
+    userOpenid?: string;
+  },
+): number {
+  if (rule.moduleId) {
+    ModuleIdSchema.parse(rule.moduleId);
+  }
+  db.run(
+    `INSERT INTO acl_rules (scope, target_id, subject, effect, module_id, user_openid, created_at)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    [
+      rule.scope,
+      rule.targetId,
+      rule.subject,
+      rule.effect,
+      rule.moduleId ?? null,
+      rule.userOpenid ?? null,
+      new Date().toISOString(),
+    ],
+  );
+  const row = db.get<{ id: number }>('SELECT last_insert_rowid() AS id');
+  return row?.id ?? 0;
+}
+
+/**
+ * 删除 ACL。
+ *
+ * @param db - 数据库
+ * @param id - 规则 id
+ * @returns 无返回值
+ */
+export function deleteAclRule(db: LaniusDb, id: number): void {
+  db.run('DELETE FROM acl_rules WHERE id = ?', [id]);
+}
+
+/**
+ * 写入审计事件。
+ *
+ * @param db - 数据库
+ * @param event - 事件
+ * @returns 无返回值
+ */
+export function writeAuditEvent(db: LaniusDb, event: AuditEventInput): void {
+  db.run(
+    `INSERT INTO audit_events
+      (ts, scene, target_id, user_id, module_id, outcome, latency_ms, request_id, detail)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    [
+      new Date().toISOString(),
+      event.scene,
+      event.targetId,
+      event.userId,
+      event.moduleId,
+      event.outcome,
+      event.latencyMs,
+      event.requestId,
+      event.detail ?? '',
+    ],
+  );
+}
+
+/**
+ * 查询审计（最新优先）。
+ *
+ * @param db - 数据库
+ * @param limit - 条数上限
+ * @returns 行列表
+ */
+export function listAuditEvents(
+  db: LaniusDb,
+  limit = 100,
+): Array<Record<string, unknown>> {
+  return db.all(
+    `SELECT id, ts, scene, target_id, user_id, module_id, outcome, latency_ms, request_id, detail
+     FROM audit_events ORDER BY id DESC LIMIT ?`,
+    [limit],
+  );
+}
diff --git a/apps/api/src/db/seed.ts b/apps/api/src/db/seed.ts
new file mode 100644
index 0000000..a3bde09
--- /dev/null
+++ b/apps/api/src/db/seed.ts
@@ -0,0 +1,220 @@
+import { LANIUS_COMMAND_CATALOG, buildHelpDto } from '@lanius/core';
+
+import type { LaniusDb } from './client.js';
+
+/**
+ * 轮换表条目形态。
+ */
+type RotationSeedItem =
+  | string
+  | { name: string; element?: string; bonusPct?: number };
+
+/**
+ * Ergo Glast 信条货架（5 把平级；Valence 为 wiki 玩家上报示例，需随商店刷新人工更新）。
+ */
+const DEFAULT_TENET: RotationSeedItem[] = [
+  { name: 'Tenet Ferrox', element: 'electricity', bonusPct: 27.7 },
+  { name: 'Tenet Grigori', element: 'toxin', bonusPct: 46.8 },
+  { name: 'Tenet Livia', element: 'electricity', bonusPct: 50.9 },
+  { name: 'Tenet Exec', element: 'toxin', bonusPct: 25.1 },
+  { name: 'Tenet Agendus', element: 'impact', bonusPct: 40.7 },
+];
+
+/**
+ * Eleanor 终幕 Batch A 货架（7 把平级；百分比对齐 wiki 当期示例）。
+ */
+const DEFAULT_CODA: RotationSeedItem[] = [
+  { name: 'Coda Catabolyst', element: 'radiation', bonusPct: 30.5 },
+  { name: 'Coda Hema', element: 'magnetic', bonusPct: 28.9 },
+  { name: 'Coda Mire', element: 'cold', bonusPct: 25.2 },
+  { name: 'Coda Motovore', element: 'impact', bonusPct: 34.9 },
+  { name: 'Coda Pox', element: 'magnetic', bonusPct: 29.6 },
+  { name: 'Coda Sporothrix', element: 'electricity', bonusPct: 29.7 },
+  { name: 'Dual Coda Torxica', element: 'magnetic', bonusPct: 25.3 },
+];
+
+/**
+ * 需被商店货架模型替换的旧「单武器轮换」名单（Sisters / 假 Valence）。
+ */
+const LEGACY_TENET_NAME_SETS: string[][] = [
+  [
+    'Tenet Arca Plasmor',
+    'Tenet Envoy',
+    'Tenet Tetra',
+    'Tenet Cycron',
+    'Tenet Detron',
+    'Tenet Diplos',
+    'Tenet Flux Rifle',
+    'Tenet Spirex',
+  ],
+];
+
+/**
+ * 旧终幕短名单（缺 Batch A 全套）。
+ */
+const LEGACY_CODA_NAME_SETS: string[][] = [
+  [
+    'Coda Hema',
+    'Coda Sporothrix',
+    'Coda Synapse',
+    'Coda Catabolyst',
+    'Coda Dual Torxica',
+    'Coda Pox',
+  ],
+  [
+    'Coda Hema',
+    'Coda Sporothrix',
+    'Coda Synapse',
+    'Coda Catabolyst',
+    'Dual Coda Torxica',
+    'Coda Pox',
+  ],
+];
+
+/** 商店 Valence 刷新周期（天；与官方 96h 对齐）。 */
+const SHOP_PERIOD_DAYS = 4;
+
+/** 周期 epoch（UTC 日界，可被 admin 覆盖）。 */
+const SHOP_EPOCH_ISO = '2025-03-18T00:00:00.000Z';
+
+/**
+ * 播种模块开关、帮助菜单与轮换表；已有库则补齐缺失模块行。
+ *
+ * @param db - SQLite 句柄
+ * @returns 无返回值
+ */
+export function seedDatabaseIfEmpty(db: LaniusDb): void {
+  const count = db.get<{ c: number }>('SELECT COUNT(*) AS c FROM module_settings');
+  if ((count?.c ?? 0) === 0) {
+    let order = 0;
+    for (const entry of LANIUS_COMMAND_CATALOG) {
+      db.run(
+        `INSERT INTO module_settings (module_id, enabled, sort_order, help_override_json)
+         VALUES (?, 1, ?, NULL)`,
+        [entry.id, order++],
+      );
+    }
+    const help = buildHelpDto();
+    db.run(
+      `INSERT INTO help_menu (id, title_zh, title_en, intro_zh, intro_en, visible_module_ids_json)
+       VALUES (1, ?, ?, ?, ?, ?)`,
+      [
+        help.title.zh,
+        help.title.en,
+        help.intro.zh,
+        help.intro.en,
+        JSON.stringify(LANIUS_COMMAND_CATALOG.map((entry) => entry.id)),
+      ],
+    );
+  } else {
+    const existing = new Set(
+      db
+        .all<{ module_id: string }>('SELECT module_id FROM module_settings')
+        .map((row) => row.module_id),
+    );
+    let order =
+      db.get<{ m: number }>('SELECT COALESCE(MAX(sort_order), 0) AS m FROM module_settings')
+        ?.m ?? 0;
+    for (const entry of LANIUS_COMMAND_CATALOG) {
+      if (existing.has(entry.id)) {
+        continue;
+      }
+      order += 1;
+      db.run(
+        `INSERT INTO module_settings (module_id, enabled, sort_order, help_override_json)
+         VALUES (?, 1, ?, NULL)`,
+        [entry.id, order],
+      );
+    }
+  }
+
+  seedRotationIfMissing(db, 'tenetRotation', DEFAULT_TENET);
+  seedRotationIfMissing(db, 'codaRotation', DEFAULT_CODA);
+  upgradeLegacyShopRotation(db, 'tenetRotation', DEFAULT_TENET, LEGACY_TENET_NAME_SETS);
+  upgradeLegacyShopRotation(db, 'codaRotation', DEFAULT_CODA, LEGACY_CODA_NAME_SETS);
+}
+
+/**
+ * 写入默认轮换表（仅当行不存在）。
+ *
+ * @param db - 数据库
+ * @param moduleId - tenetRotation | codaRotation
+ * @param items - 货架条目
+ * @returns 无返回值
+ */
+function seedRotationIfMissing(
+  db: LaniusDb,
+  moduleId: string,
+  items: RotationSeedItem[],
+): void {
+  const row = db.get<{ module_id: string }>(
+    'SELECT module_id FROM rotation_schedules WHERE module_id = ?',
+    [moduleId],
+  );
+  if (row) {
+    return;
+  }
+  db.run(
+    `INSERT INTO rotation_schedules (module_id, epoch_iso, period_days, items_json)
+     VALUES (?, ?, ?, ?)`,
+    [moduleId, SHOP_EPOCH_ISO, SHOP_PERIOD_DAYS, JSON.stringify(items)],
+  );
+}
+
+/**
+ * 将旧「单把轮换 / 错误名单」升级为商店货架默认表。
+ *
+ * @param db - 数据库
+ * @param moduleId - tenetRotation | codaRotation
+ * @param defaults - 新默认货架
+ * @param legacyNameSets - 可识别的旧名单集合
+ * @returns 无返回值
+ */
+function upgradeLegacyShopRotation(
+  db: LaniusDb,
+  moduleId: string,
+  defaults: RotationSeedItem[],
+  legacyNameSets: string[][],
+): void {
+  const row = db.get<{ items_json: string }>(
+    'SELECT items_json FROM rotation_schedules WHERE module_id = ?',
+    [moduleId],
+  );
+  if (!row) {
+    return;
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(row.items_json) as unknown;
+  } catch {
+    return;
+  }
+  if (!Array.isArray(parsed) || parsed.length === 0) {
+    return;
+  }
+  const currentNames = parsed
+    .map((entry) => {
+      if (typeof entry === 'string') {
+        return entry.trim();
+      }
+      if (entry && typeof entry === 'object') {
+        return String((entry as { name?: unknown }).name ?? '').trim();
+      }
+      return '';
+    })
+    .filter(Boolean);
+  const isLegacy = legacyNameSets.some(
+    (legacy) =>
+      legacy.length === currentNames.length &&
+      legacy.every((name, i) => name === currentNames[i]),
+  );
+  if (!isLegacy) {
+    return;
+  }
+  db.run(
+    `UPDATE rotation_schedules
+     SET items_json = ?, period_days = ?, epoch_iso = ?
+     WHERE module_id = ?`,
+    [JSON.stringify(defaults), SHOP_PERIOD_DAYS, SHOP_EPOCH_ISO, moduleId],
+  );
+}
