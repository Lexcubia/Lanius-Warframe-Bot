+      return new Response(JSON.stringify({}));
+    });
+
+    const catalog = await fetchItemIconCatalog({
+      baseUrl: 'https://example.test',
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+    });
+
+    const hit = lookupItemIcon(
