+  font-size: 0.75rem;
+  font-weight: 600;
+}
+h1 {
+  margin: 0 0 0.5rem;
+  font-family: var(--lanius-font-display);
+  color: var(--lanius-brand);
+  font-size: clamp(1.8rem, 4vw, 2.4rem);
+}
+.muted {
+  color: var(--lanius-text-muted);
+  margin: 0;
+}
+.search {
+  display: flex;
+  gap: 0.5rem;
+  width: min(640px, 100%);
+  margin: 1rem 0 1.25rem;
+}
+.search input {
+  flex: 1;
+  min-width: 0;
+  border: 1px solid var(--lanius-border-bright);
+  background: rgba(255, 255, 255, 0.92);
+  color: var(--lanius-text);
+  border-radius: 10px;
+  padding: 0.75rem 0.9rem;
+  transition:
+    border-color 0.18s ease,
+    box-shadow 0.18s ease;
+}
+.search button {
+  border: 0;
+  border-radius: 10px;
+  padding: 0 1.1rem;
+  background: linear-gradient(135deg, var(--lanius-accent), var(--lanius-highlight));
+  color: #fff;
+  font-weight: 700;
+  cursor: pointer;
+  transition:
+    filter 0.18s ease,
+    box-shadow 0.18s ease,
+    transform 0.18s ease;
+}
+
+@media (hover: hover) {
+  .search button:hover {
+    filter: brightness(1.05);
+    box-shadow: 0 8px 18px rgba(78, 183, 232, 0.28);
+    transform: translateY(-1px);
