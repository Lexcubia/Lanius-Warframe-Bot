+++ b/deploy/docker-compose.app.yml
@@ -0,0 +1,70 @@
+# 生产推荐：主体单容器 lanius-app + 旁路 Caddy（HTTPS）。
+# 在 deploy/ 目录：
+#   IMAGE_TAG=vX.Y.Z docker compose -f docker-compose.app.yml pull && up -d
+#
+# 日常升级：release 分支 Actions 或 Admin 选版 → update-image.sh（仅 pull，不 build）
+
+name: lanius
+
+services:
+  lanius-app:
+    image: ${GHCR_IMAGE_PREFIX:-ghcr.io/lexcubia/lanius-warframe-bot}/lanius-app:${IMAGE_TAG:-latest}
+    build:
+      context: ..
+      dockerfile: deploy/Dockerfile.app
+    restart: unless-stopped
+    environment:
+      NODE_ENV: production
+      PUBLIC_SITE_BASE_URL: ${PUBLIC_SITE_BASE_URL:-https://localhost}
+      IMAGE_TAG: ${IMAGE_TAG:-latest}
+      LANIUS_CONFIG_ROOT: /config
+      # 可选：挂载 docker.sock 后 Admin 可执行 update-image.sh
+      # DOCKER_HOST: unix:///var/run/docker.sock
+    volumes:
+      # 模块化配置：default 只读，local 可写（Admin 热更新）
+      - ${LANIUS_CONFIG_DEFAULT:-../config/default}:/config/default:ro
+      - ${LANIUS_CONFIG_LOCAL:-../config/local}:/config/local:rw
+      # 兼容：若仍有单体 secrets，挂载后首次启动会拆分进 local/
+      - ${LANIUS_CONFIG_FILE:-/opt/lanius/secrets/config.local.yaml}:/config/config.local.yaml:ro
+      - ${LANIUS_DATA_DIR:-/opt/lanius/data}:/data
+      - ${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}:/ms-playwright:ro
+      # 可选：后台选版（取消下一行注释）
+      # - /var/run/docker.sock:/var/run/docker.sock
+      # - ./update-image.sh:/opt/lanius/repo/deploy/update-image.sh:ro
+      # - .:/opt/lanius/repo/deploy:rw
+    expose:
+      - '8787'
+      - '8788'
+      - '8790'
+    healthcheck:
+      test:
+        [
+          'CMD',
+          'node',
+          '-e',
+          "fetch('http://127.0.0.1:8787/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
+        ]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 45s
+
+  caddy:
+    image: caddy:2.9-alpine
+    restart: unless-stopped
+    ports:
+      - '80:80'
+      - '443:443'
+    environment:
+      DOMAIN: ${DOMAIN:-localhost}
+    volumes:
+      - ./Caddyfile.app:/etc/caddy/Caddyfile:ro
+      - caddy_data:/data
+      - caddy_config:/config
+    depends_on:
+      lanius-app:
+        condition: service_healthy
+
+volumes:
+  caddy_data:
+  caddy_config:
