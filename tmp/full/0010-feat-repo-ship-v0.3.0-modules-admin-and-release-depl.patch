diff --git a/apps/web/plugins/color-mode.client.ts b/apps/web/plugins/color-mode.client.ts
new file mode 100644
index 0000000..9c44feb
--- /dev/null
+++ b/apps/web/plugins/color-mode.client.ts
@@ -0,0 +1,35 @@
+/**
+ * 颜色模式：公开站固定亮色 anime；管理后台可保留本地暗色偏好。
+ */
+import { useLaniusColorMode } from '~/composables/useLaniusColorMode';
+
+export default defineNuxtPlugin(() => {
+  const route = useRoute();
+  const { restoreMode, setMode } = useLaniusColorMode();
+
+  /**
+   * 当前是否管理后台路径。
+   *
+   * @returns 是否 `/admin`
+   */
+  function isAdminPath(): boolean {
+    const path = route.path;
+    return path === '/admin' || path.endsWith('/admin');
+  }
+
+  /**
+   * 按路由应用颜色模式。
+   *
+   * @returns 无返回值
+   */
+  function syncColorMode(): void {
+    if (isAdminPath()) {
+      restoreMode();
+      return;
+    }
+    // 公开站统一亮色，避免与暖底 token 冲突
+    setMode('light');
+  }
+
+  watch(() => route.path, syncColorMode, { immediate: true });
+});
diff --git a/apps/web/plugins/public-theme.ts b/apps/web/plugins/public-theme.ts
new file mode 100644
index 0000000..79389b0
--- /dev/null
+++ b/apps/web/plugins/public-theme.ts
@@ -0,0 +1,43 @@
+/**
+ * 公开站视觉主题：暖底 anime；与 Admin 暗壳分离。
+ * 公开页强制 `color-scheme: light`，避免系统暗色 / 半成品 `theme-dark` 把配色打乱。
+ */
+export default defineNuxtPlugin(() => {
+  const route = useRoute();
+
+  /**
+   * 当前是否管理后台路径。
+   *
+   * @returns 是否 `/admin`
+   */
+  const isAdmin = computed(() => {
+    const path = route.path;
+    return path === '/admin' || path.endsWith('/admin');
+  });
+
+  useHead({
+    bodyAttrs: {
+      class: computed(() => (isAdmin.value ? '' : 'theme-anime')),
+    },
+    htmlAttrs: {
+      style: computed(() =>
+        isAdmin.value ? undefined : 'color-scheme: light',
+      ),
+    },
+  });
+
+  /**
+   * 客户端清理暗色残留 class。
+   *
+   * @returns 无返回值
+   */
+  function clearPublicDark(): void {
+    if (!import.meta.client || isAdmin.value) return;
+    document.documentElement.classList.remove('theme-dark', 'dark');
+    document.documentElement.classList.remove('theme-anime-boot');
+    document.documentElement.style.colorScheme = 'light';
+    document.body.classList.add('theme-anime');
+  }
+
+  watch(isAdmin, clearPublicDark, { immediate: true });
+});
