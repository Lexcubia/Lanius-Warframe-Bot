new file mode 100644
index 0000000..12de2b2
--- /dev/null
+++ b/apps/api/src/services/market-service.ts
@@ -0,0 +1,123 @@
+import type { MarketItemDto, MarketSearchDto } from '@lanius/core';
+
+import { WarframeMarketClient } from '../adapters/warframe-market/client.js';
+import type { CacheStore } from '../cache/types.js';
+import { validationError } from '../lib/http-error.js';
+
+const ITEMS_INDEX_TTL_MS = 6 * 60 * 60_000;
+const ITEM_ORDERS_TTL_MS = 90_000;
+
+/**
+ * Warframe Market 物品行情服务。
+ */
+export class MarketService {
+  private readonly cache: CacheStore;
+  private readonly client: WarframeMarketClient;
+
+  /**
+   * @param deps - 缓存与上游客户端
+   */
+  constructor(deps: { cache: CacheStore; client?: WarframeMarketClient }) {
+    this.cache = deps.cache;
+    this.client = deps.client ?? new WarframeMarketClient();
+  }
+
+  /**
+   * 按关键词搜索物品并附带买卖价摘要。
+   *
+   * @param query - 用户查询串
+   * @returns 搜索 DTO
+   */
+  async search(query: string): Promise<MarketSearchDto> {
+    const q = query.trim();
+    if (!q) {
+      throw validationError('query is required');
+    }
+
+    const items = await this.getItemIndex();
+    const needle = q.toLowerCase();
+    const matched = items
+      .filter(
+        (item) =>
+          item.url_name.toLowerCase().includes(needle) ||
+          item.item_name.toLowerCase().includes(needle),
+      )
+      .slice(0, 5);
+
+    const results: MarketItemDto[] = [];
+    for (const item of matched) {
+      results.push(await this.summarizeItem(item.url_name, item.item_name));
+    }
+
+    return { query: q, items: results };
+  }
+
+  /**
+   * 读取（或刷新）物品索引。
+   *
+   * @returns 索引行
+   */
+  private async getItemIndex(): Promise<
+    Array<{ url_name: string; item_name: string }>
+  > {
+    const key = 'wfm:items:index';
+    const fresh = await this.cache.getFresh<
+      Array<{ url_name: string; item_name: string }>
+    >(key);
+    if (fresh) {
+      return fresh.value;
+    }
+    const items = await this.client.listItems();
+    const slim = items.map((item) => ({
+      url_name: item.url_name,
+      item_name: item.item_name,
+    }));
+    await this.cache.set(key, slim, ITEMS_INDEX_TTL_MS);
+    return slim;
+  }
+
+  /**
+   * 汇总单物品买卖盘。
+   *
+   * @param urlName - slug
+   * @param itemName - 展示名
+   * @returns MarketItemDto
+   */
+  private async summarizeItem(
+    urlName: string,
+    itemName: string,
+  ): Promise<MarketItemDto> {
+    const key = `wfm:item:${urlName}`;
+    const cached = await this.cache.getFresh<MarketItemDto>(key);
+    if (cached) {
+      return cached.value;
+    }
+
+    const orders = await this.client.listOrders(urlName);
+    const online = orders.filter(
+      (order) =>
+        !order.user?.status ||
+        order.user.status === 'ingame' ||
+        order.user.status === 'online',
+    );
+    const sells = online
+      .filter((order) => order.order_type === 'sell')
+      .map((order) => order.platinum)
+      .sort((a, b) => a - b);
+    const buys = online
+      .filter((order) => order.order_type === 'buy')
+      .map((order) => order.platinum)
+      .sort((a, b) => b - a);
+
+    const dto: MarketItemDto = {
+      urlName,
+      name: { zh: itemName, en: itemName },
+      lowestSell: sells[0] ?? null,
+      highestBuy: buys[0] ?? null,
+      volume: online.length,
+      updatedAt: new Date().toISOString(),
+    };
+    await this.cache.set(key, dto, ITEM_ORDERS_TTL_MS);
+    return dto;
+  }
+}
diff --git a/apps/api/src/services/module-gate.ts b/apps/api/src/services/module-gate.ts
new file mode 100644
index 0000000..a210bb5
--- /dev/null
+++ b/apps/api/src/services/module-gate.ts
@@ -0,0 +1,75 @@
+import type { ModuleId } from '@lanius/core';
+
+import type { LaniusDb } from '../db/client.js';
+import { listAclRules, listModuleSettings } from '../db/repositories.js';
+import { forbiddenError } from '../lib/http-error.js';
+
+/**
+ * 门禁裁决上下文（QQ 场景）。
+ */
+export type GateContext = {
+  scene: 'group' | 'c2c' | 'web' | 'system';
+  targetId: string;
+  userId: string;
+  moduleId: ModuleId;
+};
+
+/**
+ * 判断模块是否允许执行。
+ *
+ * 优先级：deny > allow；group/c2c 规则 > global；无规则默认允许。
+ * `mode` 模块始终放行。
+ *
+ * @param db - SQLite
+ * @param ctx - 场景上下文
+ * @returns 允许时无返回；拒绝时抛 HttpError
+ * @throws HttpError 拒绝访问时
+ */
+export function assertModuleAllowed(db: LaniusDb, ctx: GateContext): void {
+  if (ctx.moduleId === 'mode') {
+    return;
+  }
+
+  const settings = listModuleSettings(db);
+  const setting = settings.find((row) => row.module_id === ctx.moduleId);
+  if (setting && setting.enabled !== 1) {
+    throw forbiddenError(`Module disabled: ${ctx.moduleId}`);
+  }
+
+  const rules = listAclRules(db);
+  const applicable = rules.filter((rule) => {
+    if (rule.scope === 'global') {
+      return true;
+    }
+    if (rule.scope === ctx.scene && rule.target_id === ctx.targetId) {
+      return true;
+    }
+    return false;
+  });
+
+  // 更具体 scope 优先：非 global 排前
+  applicable.sort((a, b) => {
+    const score = (scope: string) => (scope === 'global' ? 0 : 1);
+    return score(b.scope) - score(a.scope);
+  });
+
+  let decision: 'allow' | 'deny' | null = null;
+  for (const rule of applicable) {
+    if (rule.subject === 'module' && rule.module_id === ctx.moduleId) {
+      decision = rule.effect === 'deny' ? 'deny' : 'allow';
+      if (decision === 'deny') {
+        break;
+      }
+    }
+    if (rule.subject === 'user' && rule.user_openid === ctx.userId) {
+      decision = rule.effect === 'deny' ? 'deny' : 'allow';
+      if (decision === 'deny') {
+        break;
+      }
+    }
+  }
+
+  if (decision === 'deny') {
+    throw forbiddenError(`ACL denied module=${ctx.moduleId}`);
+  }
+}
diff --git a/apps/api/src/services/push-service.ts b/apps/api/src/services/push-service.ts
new file mode 100644
index 0000000..97b0d83
--- /dev/null
+++ b/apps/api/src/services/push-service.ts
@@ -0,0 +1,389 @@
+import { createHash } from 'node:crypto';
+
+import {
+  pickLocalized,
+  type Locale,
+  type PushDispatchDto,
+  type PushFrequency,
+  type Realm,
+  type SubscribableModuleId,
+} from '@lanius/core';
+
+import type { LaniusDb } from '../db/client.js';
+import {
+  listEnabledSubscriptionRows,
+  markSubscriptionPushed,
+  type SubscriptionRow,
+} from '../db/subscriptions.js';
+import type { RotationService } from './rotation-service.js';
+import type { TraderService } from './trader-service.js';
+import type { WorldstateService } from './worldstate-service.js';
+
+/**
+ * 推送服务依赖。
+ */
+export type PushServiceDeps = {
+  db: LaniusDb;
+  worldstateService: WorldstateService;
+  traderService: TraderService;
+  rotationService: RotationService;
+  realm: Realm;
+  locale: Locale;
+};
+
+/**
+ * 待下行条目（含指纹，供 ack）。
+ */
+export type PushPending = PushDispatchDto & { fingerprint: string };
+
+/**
+ * 按订阅频率检查变更并生成 QQ 下行文本。
+ */
+export class PushService {
+  private readonly db: LaniusDb;
+  private readonly worldstateService: WorldstateService;
+  private readonly traderService: TraderService;
+  private readonly rotationService: RotationService;
+  private readonly realm: Realm;
+  private readonly locale: Locale;
+
+  /**
+   * @param deps - DB 与查询服务
+   */
+  constructor(deps: PushServiceDeps) {
+    this.db = deps.db;
+    this.worldstateService = deps.worldstateService;
+    this.traderService = deps.traderService;
+    this.rotationService = deps.rotationService;
+    this.realm = deps.realm;
+    this.locale = deps.locale;
+  }
+
+  /**
+   * 扫描启用订阅，返回需要推送的下行列表。
+   *
+   * @param nowMs - 当前时间
+   * @returns 待发送条目
+   */
+  async collectDue(nowMs: number = Date.now()): Promise<PushPending[]> {
+    const rows = listEnabledSubscriptionRows(this.db);
+    if (rows.length === 0) {
+      return [];
+    }
+
+    const snapshots = await this.buildSnapshots();
+    const due: PushPending[] = [];
+
+    for (const row of rows) {
+      const moduleId = row.module_id as SubscribableModuleId;
+      const snap = snapshots[moduleId];
+      if (!snap) {
+        continue;
+      }
+      if (!isDue(row, snap.fingerprint, nowMs)) {
+        continue;
+      }
+      due.push({
+        subscriptionId: row.id,
+        scene: row.scene as 'group' | 'c2c',
+        targetId: row.target_id,
+        moduleId,
+        text: snap.text,
+        fingerprint: snap.fingerprint,
+      });
+    }
+
+    return due;
+  }
+
+  /**
+   * 确认推送已发出，更新指纹与时间。
+   *
+   * @param subscriptionId - 订阅 id
+   * @param fingerprint - 本次内容指纹
+   * @returns 无返回值
+   */
+  acknowledge(subscriptionId: number, fingerprint: string): void {
+    markSubscriptionPushed(
+      this.db,
+      subscriptionId,
+      fingerprint,
+      new Date().toISOString(),
+    );
+  }
+
+  /**
+   * 为各可订阅模块构建指纹与推送文案。
+   *
+   * @returns 模块 → 快照
+   */
+  private async buildSnapshots(): Promise<
+    Partial<Record<SubscribableModuleId, { fingerprint: string; text: string }>>
+  > {
+    const locale = this.locale;
+    const realm = this.realm;
+    const out: Partial<
+      Record<SubscribableModuleId, { fingerprint: string; text: string }>
+    > = {};
+
+    const ws = await this.worldstateService.getWorldstate(realm, locale);
+    const fissureKey = ws.data.fissures
+      .map(
+        (f) =>
+          `${f.id}|${f.node.en}|${f.missionType.en}|${f.era}|${f.path}|${f.expiry}`,
+      )
+      .sort()
+      .join(';');
+    out.fissures = {
+      fingerprint: hashFingerprint(fissureKey),
+      text: formatFissuresPush(ws.data.fissures, locale),
+    };
+
+    const baro = await this.traderService.getVoidTrader(realm, locale);
+    const baroKey = [
+      baro.data.active ? '1' : '0',
+      baro.data.node.en,
+      baro.data.expiry,
+      ...baro.data.inventory.map((i) => i.name.en),
+    ].join('|');
+    out.voidTrader = {
+      fingerprint: hashFingerprint(baroKey),
+      text: formatVoidTraderPush(baro.data, locale),
+    };
+
+    const varzia = await this.traderService.getVarzia(realm, locale);
+    const varziaKey = [
+      varzia.data.active ? '1' : '0',
+      varzia.data.expiry ?? '',
+      ...varzia.data.inventory.map((i) => i.name.en),
+    ].join('|');
+    out.varzia = {
+      fingerprint: hashFingerprint(varziaKey),
+      text: formatVarziaPush(varzia.data, locale),
+    };
+
+    const tenet = await this.rotationService.getRotation('tenet');
+    out.tenetRotation = {
+      fingerprint: hashFingerprint(
+        `${tenet.periodEnd}|${tenet.offerings.map((o) => `${o.name.en}:${o.element ?? ''}:${o.bonusPct ?? ''}`).join('|')}`,
+      ),
+      text: formatRotationPush(tenet, locale),
+    };
+
+    const coda = await this.rotationService.getRotation('coda');
+    out.codaRotation = {
+      fingerprint: hashFingerprint(
+        `${coda.periodEnd}|${coda.offerings.map((o) => `${o.name.en}:${o.element ?? ''}:${o.bonusPct ?? ''}`).join('|')}`,
+      ),
+      text: formatRotationPush(coda, locale),
+    };
+
+    return out;
+  }
+}
+
+/**
+ * 判断订阅是否到期应推送。
+ *
+ * @param row - 订阅行
+ * @param fingerprint - 当前内容指纹
+ * @param nowMs - 当前时间
+ * @returns 是否应推送
+ */
+function isDue(row: SubscriptionRow, fingerprint: string, nowMs: number): boolean {
+  const frequency = row.frequency as PushFrequency;
+  if (frequency === 'on_change') {
+    return row.last_fingerprint !== fingerprint;
+  }
+  const intervalMs = frequencyIntervalMs(frequency);
+  if (row.last_pushed_at == null) {
+    return true;
+  }
+  const last = Date.parse(row.last_pushed_at);
+  if (!Number.isFinite(last)) {
+    return true;
+  }
+  return nowMs - last >= intervalMs;
+}
+
+/**
+ * 频率对应最小间隔。
+ *
+ * @param frequency - 推送频率
+ * @returns 毫秒
+ */
+function frequencyIntervalMs(frequency: Exclude<PushFrequency, 'on_change'>): number {
+  switch (frequency) {
+    case 'hourly':
+      return 60 * 60 * 1000;
+    case 'daily':
+      return 24 * 60 * 60 * 1000;
+    case 'weekly':
+      return 7 * 24 * 60 * 60 * 1000;
+    default:
+      return 24 * 60 * 60 * 1000;
+  }
+}
+
+/**
+ * 计算内容指纹。
+ *
+ * @param raw - 稳定序列化串
+ * @returns sha256 十六进制前 32 位
+ */
+function hashFingerprint(raw: string): string {
+  return createHash('sha256').update(raw).digest('hex').slice(0, 32);
+}
+
+/**
+ * 裂隙推送文案（精简）。
+ *
+ * @param fissures - 裂隙列表
+ * @param locale - 语言
+ * @returns 文本
+ */
+function formatFissuresPush(
+  fissures: Array<{
+    node: { zh: string; en: string };
+    missionType: { zh: string; en: string };
+    eraLabel: { zh: string; en: string };
+    pathLabel: { zh: string; en: string };
+    remainingMs: number;
+  }>,
+  locale: Locale,
+): string {
+  const zh = locale === 'zh';
+  const lines = [zh ? '【Lanius · 裂隙推送】' : '[Lanius · Fissures]'];
+  const rows = fissures.slice(0, 12);
+  if (rows.length === 0) {
+    lines.push(zh ? '· 暂无活跃裂隙' : '· none active');
+  } else {
+    for (const row of rows) {
+      const node = pickLocalized(row.node, locale);
+      const mission = pickLocalized(row.missionType, locale);
+      const era = pickLocalized(row.eraLabel, locale);
+      const path = pickLocalized(row.pathLabel, locale);
+      const mins = Math.max(0, Math.round(row.remainingMs / 60_000));
+      lines.push(`· ${era} ${mission} @ ${node} (${path}) ~${mins}m`);
+    }
+  }
+  return lines.join('\n');
+}
+
+/**
+ * 虚空商人推送文案。
+ *
+ * @param data - DTO
+ * @param locale - 语言
+ * @returns 文本
+ */
+function formatVoidTraderPush(
+  data: {
+    character: { zh: string; en: string };
+    node: { zh: string; en: string };
+    active: boolean;
+    remainingMs: number;
+    inventory: Array<{ name: { zh: string; en: string }; ducats?: number }>;
+  },
+  locale: Locale,
+): string {
+  const zh = locale === 'zh';
+  const name = pickLocalized(data.character, locale);
+  const node = pickLocalized(data.node, locale);
+  const mins = Math.max(0, Math.round(data.remainingMs / 60_000));
+  const lines = [zh ? `【Lanius · ${name}】` : `[Lanius · ${name}]`];
+  if (data.active) {
+    lines.push(zh ? `驻留 ${node}，约 ${mins} 分钟后离开` : `At ${node}, leaves in ~${mins}m`);
+  } else {
+    lines.push(zh ? `未在场，约 ${mins} 分钟后抵达 ${node}` : `Arrives at ${node} in ~${mins}m`);
+  }
+  for (const item of data.inventory.slice(0, 15)) {
+    const label = pickLocalized(item.name, locale);
+    const ducats = item.ducats != null ? ` ${item.ducats}d` : '';
+    lines.push(`· ${label}${ducats}`);
+  }
+  return lines.join('\n');
+}
+
+/**
+ * 瓦奇娅推送文案。
+ *
+ * @param data - DTO
+ * @param locale - 语言
+ * @returns 文本
+ */
+function formatVarziaPush(
+  data: {
+    character: { zh: string; en: string };
+    active: boolean;
+    remainingMs?: number;
+    inventory: Array<{ name: { zh: string; en: string } }>;
+  },
+  locale: Locale,
+): string {
+  const zh = locale === 'zh';
+  const name = pickLocalized(data.character, locale);
+  const lines = [zh ? `【Lanius · ${name}】` : `[Lanius · ${name}]`];
+  if (data.remainingMs != null) {
+    const mins = Math.max(0, Math.round(data.remainingMs / 60_000));
+    lines.push(zh ? `货架剩余约 ${mins} 分钟` : `~${mins}m left`);
+  }
+  if (data.inventory.length === 0) {
+    lines.push(zh ? '· 货架为空或未开放' : '· empty / inactive');
+  } else {
+    for (const item of data.inventory.slice(0, 20)) {
+      lines.push(`· ${pickLocalized(item.name, locale)}`);
+    }
+  }
+  return lines.join('\n');
+}
+
+/**
+ * 格式化轮换推送文案（货架平级 + 可选 Valence）。
+ *
+ * @param data - 轮换 DTO
+ * @param locale - 语言
+ * @returns 多行文本
+ */
+function formatRotationPush(
+  data: {
+    kind: 'tenet' | 'coda';
+    offerings: Array<{
+      name: { zh: string; en: string };
+      elementLabel?: { zh: string; en: string };
+      bonusPct?: number;
+    }>;
+    remainingMs: number;
+  },
+  locale: Locale,
+): string {
+  const zh = locale === 'zh';
+  const title =
+    data.kind === 'tenet'
+      ? zh
+        ? '信条武器商店'
+        : 'Tenet shop'
+      : zh
+        ? '终幕武器商店'
+        : 'Coda shop';
+  const days = Math.max(0, Math.round(data.remainingMs / 86_400_000));
+  const lines = [
+    zh ? `【Lanius · ${title}】` : `[Lanius · ${title}]`,
+    zh
+      ? `约 ${days} 天后刷新 Valence`
+      : `Valence refreshes in ~${days}d`,
+  ];
+  for (const weapon of data.offerings) {
+    const name = pickLocalized(weapon.name, locale);
+    const el = weapon.elementLabel
+      ? pickLocalized(weapon.elementLabel, locale)
+      : '';
+    const pct =
+      weapon.bonusPct != null
+        ? `${Number(weapon.bonusPct.toFixed(1))}%`
+        : '';
+    const valence = [el, pct].filter(Boolean).join(' ');
+    lines.push(valence ? `· ${name} [${valence}]` : `· ${name}`);
+  }
+  return lines.join('\n');
+}
diff --git a/apps/api/src/services/release-service.ts b/apps/api/src/services/release-service.ts
new file mode 100644
index 0000000..5a8974c
--- /dev/null
+++ b/apps/api/src/services/release-service.ts
@@ -0,0 +1,193 @@
+import { execFile } from 'node:child_process';
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { promisify } from 'node:util';
+
+import type { ModuleConfigMap } from '@lanius/config';
+
+const execFileAsync = promisify(execFile);
+
+/**
+ * GitHub Release 摘要。
+ */
+export type GithubReleaseSummary = {
+  tag: string;
+  name: string;
+  publishedAt: string | null;
+  prerelease: boolean;
+  draft: boolean;
+};
+
+/**
+ * 当前运行版本信息。
+ */
+export type CurrentReleaseInfo = {
+  imageTag: string | null;
+  packageVersion: string | null;
+  gitSha: string | null;
+};
+
+/**
+ * 从 GitHub API 列出 Releases（公开；可选 token）。
+ *
+ * @param github - github 模块配置
+ * @returns 发布列表（最新在前）
+ */
+export async function listGithubReleases(
+  github: ModuleConfigMap['github'],
+): Promise<GithubReleaseSummary[]> {
+  const url = `https://api.github.com/repos/${github.owner}/${github.repo}/releases?per_page=30`;
+  const headers: Record<string, string> = {
+    Accept: 'application/vnd.github+json',
+    'User-Agent': 'Lanius-Warframe-Bot',
+  };
+  if (github.token) {
+    headers.Authorization = `Bearer ${github.token}`;
+  }
+  const response = await fetch(url, { headers });
+  if (!response.ok) {
+    // 无 Release 时回退 tags
+    return listGithubTags(github);
+  }
+  const rows = (await response.json()) as Array<{
+    tag_name?: string;
+    name?: string;
+    published_at?: string;
+    prerelease?: boolean;
+    draft?: boolean;
+  }>;
+  if (!Array.isArray(rows) || rows.length === 0) {
+    return listGithubTags(github);
+  }
+  return rows
+    .filter((row) => row.tag_name && !row.draft)
+    .map((row) => ({
+      tag: row.tag_name ?? '',
+      name: row.name || row.tag_name || '',
+      publishedAt: row.published_at ?? null,
+      prerelease: Boolean(row.prerelease),
+      draft: false,
+    }));
+}
+
+/**
+ * 列出 tags（无 Release 时）。
+ *
+ * @param github - 配置
+ * @returns 摘要列表
+ */
+async function listGithubTags(
+  github: ModuleConfigMap['github'],
+): Promise<GithubReleaseSummary[]> {
+  const url = `https://api.github.com/repos/${github.owner}/${github.repo}/tags?per_page=30`;
+  const headers: Record<string, string> = {
+    Accept: 'application/vnd.github+json',
+    'User-Agent': 'Lanius-Warframe-Bot',
+  };
+  if (github.token) {
+    headers.Authorization = `Bearer ${github.token}`;
+  }
+  const response = await fetch(url, { headers });
+  if (!response.ok) {
+    return [];
+  }
+  const rows = (await response.json()) as Array<{ name?: string }>;
+  return (rows ?? [])
+    .filter((row) => row.name)
+    .map((row) => ({
+      tag: row.name ?? '',
+      name: row.name ?? '',
+      publishedAt: null,
+      prerelease: false,
+      draft: false,
+    }));
+}
+
+/**
+ * 读取当前镜像/包版本。
+ *
+ * @returns CurrentReleaseInfo
+ */
+export function getCurrentReleaseInfo(): CurrentReleaseInfo {
+  return {
+    imageTag: process.env.IMAGE_TAG?.trim() || null,
+    packageVersion: readRootPackageVersion(),
+    gitSha: process.env.GIT_SHA?.trim() || null,
+  };
+}
+
+/**
+ * 尝试应用镜像 tag：调用 update-image.sh（需 docker / sock）。
+ *
+ * @param github - github 模块（含 deployDir）
+ * @param tag - 如 v0.2.0
+ * @returns 执行结果
+ */
+export async function applyReleaseTag(
+  github: ModuleConfigMap['github'],
+  tag: string,
+): Promise<{
+  ok: boolean;
+  mode: 'executed' | 'manual';
+  detail: string;
+}> {
+  const script = resolve(github.deployDir, 'update-image.sh');
+  if (!existsSync(script)) {
+    return {
+      ok: false,
+      mode: 'manual',
+      detail: `缺少 ${script}。请在宿主机执行：IMAGE_TAG=${tag} docker compose -f ${github.composeFile} pull && up -d`,
+    };
+  }
+
+  // 无 docker.sock 时脚本会失败，返回手动指令
+  try {
+    const { stdout, stderr } = await execFileAsync(
+      'bash',
+      [script, tag],
+      {
+        cwd: github.deployDir,
+        env: {
+          ...process.env,
+          IMAGE_TAG: tag,
+          COMPOSE_FILE: github.composeFile,
+        },
+        timeout: 10 * 60 * 1000,
+      },
+    );
+    return {
+      ok: true,
+      mode: 'executed',
+      detail: `${stdout}\n${stderr}`.trim().slice(0, 4000),
+    };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return {
+      ok: false,
+      mode: 'manual',
+      detail: `${message}\n手动：cd ${github.deployDir} && IMAGE_TAG=${tag} bash update-image.sh ${tag}`,
+    };
+  }
+}
+
+/**
+ * 读取根 package.json version。
+ *
+ * @returns 版本或 null
+ */
+function readRootPackageVersion(): string | null {
+  const candidates = [
+    resolve(process.cwd(), 'package.json'),
+    resolve(process.cwd(), '../../package.json'),
+  ];
+  for (const path of candidates) {
+    try {
+      if (!existsSync(path)) continue;
+      const pkg = JSON.parse(readFileSync(path, 'utf8')) as { version?: string };
+      if (pkg.version) return pkg.version;
+    } catch {
+      // next
+    }
+  }
+  return null;
+}
