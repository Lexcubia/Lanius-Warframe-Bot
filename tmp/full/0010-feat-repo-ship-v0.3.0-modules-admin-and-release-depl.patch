@@ -0,0 +1,604 @@
+/**
+ * Lanius Admin — 企业级运维控制台视觉层（仅 /admin 使用）。
+ * 方向：深 slate 侧栏 + 浅工作区，青绿品牌点缀；偏密度与可读性。
+ */
+body:has(.admin-root) {
+  background: #f3f6f9;
+}
+
+.admin-root {
+  --admin-bg: #0b1220;
+  --admin-side: #111827;
+  --admin-side-hover: #1a2436;
+  --admin-side-active: #1e3a4c;
+  --admin-work: #f3f6f9;
+  --admin-panel: #ffffff;
+  --admin-line: #d7e2ec;
+  --admin-line-strong: #b7c9d8;
+  --admin-ink: #152433;
+  --admin-muted: #5f7386;
+  --admin-accent: #2b8fc4;
+  --admin-accent-soft: rgba(43, 143, 196, 0.12);
+  --admin-ok: #1f9d63;
+  --admin-danger: #d64545;
+  --admin-warn: #d97706;
+  --admin-radius: 12px;
+  --admin-side-w: 240px;
+  --admin-font: var(--lanius-font-body);
+  --admin-mono: var(--lanius-font-mono);
+  min-height: 100vh;
+  color: var(--admin-ink);
+  font-family: var(--admin-font);
+  background: var(--admin-work);
+}
+
+.admin-root *,
+.admin-root *::before,
+.admin-root *::after {
+  box-sizing: border-box;
+}
+
+.admin-root a {
+  color: inherit;
+  text-decoration: none;
+}
+
+.admin-root button,
+.admin-root input,
+.admin-root select,
+.admin-root textarea {
+  font: inherit;
+}
+
+.admin-root code {
+  font-family: var(--admin-mono);
+  font-size: 0.86em;
+  background: #eef4f8;
+  padding: 0.1rem 0.35rem;
+  border-radius: 4px;
+}
+
+/* —— 顶栏 —— */
+.admin-top {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  min-height: 56px;
+  padding: 0 1rem 0 0.85rem;
+  background: var(--admin-bg);
+  color: #e8eef5;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
+}
+
+.admin-top__brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.65rem;
+  font-family: var(--lanius-font-display);
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  white-space: nowrap;
+}
+
+.admin-top__mark {
+  width: 1.75rem;
+  height: 1.75rem;
+  display: grid;
+  place-items: center;
+  border-radius: 8px;
+  background: linear-gradient(145deg, #3aa7d6, #1d6f9a);
+  color: #fff;
+  font-size: 0.95rem;
+}
+
+.admin-top__meta {
+  margin-left: 0.25rem;
+  color: #8fa3b8;
+  font-size: 0.78rem;
+  font-family: var(--admin-mono);
+  display: none;
+}
+
+.admin-top__spacer {
+  flex: 1;
+}
+
+.admin-top__actions {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+}
+
+.admin-menu-btn {
+  display: none;
+  width: 2.25rem;
+  height: 2.25rem;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 8px;
+  background: transparent;
+  color: #e8eef5;
+  cursor: pointer;
+}
+
+/* —— 壳布局 —— */
+.admin-shell {
+  display: grid;
+  grid-template-columns: var(--admin-side-w) minmax(0, 1fr);
+  min-height: calc(100vh - 56px);
+}
+
+.admin-side {
+  background: var(--admin-side);
+  color: #c5d0dc;
+  border-right: 1px solid rgba(255, 255, 255, 0.05);
+  padding: 1rem 0.75rem 1.25rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.admin-side__label {
+  margin: 0.35rem 0.65rem 0.15rem;
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: #6b7f94;
+  font-weight: 600;
+}
+
+.admin-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 0.2rem;
+}
+
+.admin-nav__item {
+  text-align: left;
+  margin: 0;
+  padding: 0.62rem 0.75rem;
+  border: 1px solid transparent;
+  border-radius: 9px;
+  background: transparent;
+  color: #b7c4d4;
+  cursor: pointer;
+  font-size: 0.92rem;
+  transition:
+    background 0.15s ease,
+    color 0.15s ease,
+    border-color 0.15s ease;
+}
+
+.admin-nav__item:hover {
+  background: var(--admin-side-hover);
+  color: #f1f5f9;
+}
+
+.admin-nav__item--active {
+  background: var(--admin-side-active);
+  border-color: rgba(58, 167, 214, 0.35);
+  color: #f8fafc;
+  box-shadow: inset 3px 0 0 #3aa7d6;
+}
+
+.admin-side__foot {
+  margin-top: auto;
+  display: grid;
+  gap: 0.45rem;
+  padding-top: 0.75rem;
+}
+
+.admin-work {
+  min-width: 0;
+  padding: 1.25rem clamp(1rem, 2.5vw, 1.75rem) 2.5rem;
+}
+
+.admin-work__head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 0.75rem 1rem;
+  margin-bottom: 1.1rem;
+}
+
+.admin-work__title {
+  margin: 0;
+  font-family: var(--lanius-font-display);
+  font-size: clamp(1.35rem, 2.4vw, 1.7rem);
+  font-weight: 700;
+  color: var(--admin-ink);
+  letter-spacing: -0.02em;
+}
+
+.admin-work__desc {
+  margin: 0.3rem 0 0;
+  color: var(--admin-muted);
+  font-size: 0.9rem;
+  max-width: 40rem;
+  line-height: 1.45;
+}
+
+.admin-flash {
+  margin: 0 0 1rem;
+  padding: 0.7rem 0.9rem;
+  border-radius: 10px;
+  font-size: 0.9rem;
+  border: 1px solid transparent;
+}
+
+.admin-flash--ok {
+  background: rgba(31, 157, 99, 0.1);
+  border-color: rgba(31, 157, 99, 0.28);
+  color: #146b44;
+}
+
+.admin-flash--err {
+  background: rgba(214, 69, 69, 0.1);
+  border-color: rgba(214, 69, 69, 0.28);
+  color: #9f1f1f;
+}
+
+/* —— 面板 / 表单 / 表 —— */
+.admin-panel {
+  background: var(--admin-panel);
+  border: 1px solid var(--admin-line);
+  border-radius: var(--admin-radius);
+  box-shadow: 0 1px 2px rgba(15, 30, 45, 0.04);
+  padding: 1.1rem 1.2rem 1.25rem;
+}
+
+.admin-panel + .admin-panel {
+  margin-top: 1rem;
+}
+
+.admin-panel__title {
+  margin: 0 0 0.35rem;
+  font-size: 1.05rem;
+  font-weight: 700;
+  color: var(--admin-ink);
+}
+
+.admin-panel__hint {
+  margin: 0 0 0.85rem;
+  color: var(--admin-muted);
+  font-size: 0.88rem;
+  line-height: 1.5;
+}
+
+.admin-metrics {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  gap: 0.75rem;
+}
+
+.admin-metric {
+  padding: 0.9rem 1rem;
+  border-radius: 10px;
+  border: 1px solid var(--admin-line);
+  background: linear-gradient(180deg, #fbfcfe, #f4f8fb);
+}
+
+.admin-metric__label {
+  margin: 0;
+  font-size: 0.75rem;
+  color: var(--admin-muted);
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  font-weight: 600;
+}
+
+.admin-metric__value {
+  margin: 0.35rem 0 0;
+  font-family: var(--lanius-font-display);
+  font-size: 1.45rem;
+  font-weight: 700;
+  color: var(--admin-ink);
+  letter-spacing: -0.02em;
+}
+
+.admin-metric__sub {
+  margin: 0.2rem 0 0;
+  font-size: 0.78rem;
+  color: var(--admin-muted);
+  font-family: var(--admin-mono);
+  word-break: break-all;
+}
+
+.admin-field {
+  display: grid;
+  gap: 0.3rem;
+  margin: 0.55rem 0;
+  font-size: 0.9rem;
+  color: var(--admin-ink);
+}
+
+.admin-field input,
+.admin-field select,
+.admin-field textarea,
+.admin-input,
+.admin-select,
+.admin-textarea {
+  width: 100%;
+  max-width: 100%;
+  border: 1px solid var(--admin-line-strong);
+  border-radius: 8px;
+  background: #fff;
+  color: var(--admin-ink);
+  padding: 0.5rem 0.65rem;
+  outline: none;
+}
+
+.admin-field input:focus,
+.admin-field select:focus,
+.admin-field textarea:focus,
+.admin-input:focus,
+.admin-select:focus,
+.admin-textarea:focus {
+  border-color: var(--admin-accent);
+  box-shadow: 0 0 0 3px var(--admin-accent-soft);
+}
+
+.admin-textarea,
+.admin-field textarea {
+  font-family: var(--admin-mono);
+  font-size: 0.82rem;
+  line-height: 1.45;
+  resize: vertical;
+  min-height: 8rem;
+}
+
+.admin-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  margin-top: 0.85rem;
+}
+
+.admin-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.35rem;
+  margin: 0;
+  padding: 0.5rem 0.95rem;
+  border-radius: 8px;
+  border: 1px solid transparent;
+  cursor: pointer;
+  font-weight: 600;
+  font-size: 0.9rem;
+  line-height: 1.2;
+  transition:
+    background 0.15s ease,
+    border-color 0.15s ease,
+    color 0.15s ease;
+}
+
+.admin-btn:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+
+.admin-btn--primary {
+  background: linear-gradient(180deg, #3aa7d6, #2b8fc4);
+  color: #fff;
+  border-color: #277eae;
+}
+
+.admin-btn--primary:hover:not(:disabled) {
+  filter: brightness(1.05);
+}
+
+.admin-btn--ghost {
+  background: #fff;
+  color: var(--admin-ink);
+  border-color: var(--admin-line-strong);
+}
+
+.admin-btn--ghost:hover:not(:disabled) {
+  background: #f4f8fb;
+}
+
+.admin-btn--danger {
+  background: #fff;
+  color: var(--admin-danger);
+  border-color: rgba(214, 69, 69, 0.45);
+}
+
+.admin-btn--danger:hover:not(:disabled) {
+  background: rgba(214, 69, 69, 0.08);
+}
+
+.admin-btn--top {
+  background: transparent;
+  color: #d7e4f0;
+  border-color: rgba(255, 255, 255, 0.16);
+  padding: 0.4rem 0.75rem;
+  font-size: 0.85rem;
+}
+
+.admin-btn--top:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.06);
+  color: #fff;
+}
+
+.admin-table-wrap {
+  overflow: auto;
+  border: 1px solid var(--admin-line);
+  border-radius: 10px;
+  background: #fff;
+}
+
+.admin-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.86rem;
+  min-width: 560px;
+}
+
+.admin-table th,
+.admin-table td {
+  text-align: left;
+  padding: 0.65rem 0.75rem;
+  border-bottom: 1px solid var(--admin-line);
+  vertical-align: middle;
+}
+
+.admin-table th {
+  background: #f5f8fb;
+  color: var(--admin-muted);
+  font-size: 0.75rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  font-weight: 700;
+  white-space: nowrap;
+  position: sticky;
+  top: 0;
+  z-index: 1;
+}
+
+.admin-table tbody tr:hover {
+  background: #f8fbfd;
+}
+
+.admin-table tbody tr:last-child td {
+  border-bottom: 0;
+}
+
+.admin-check-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
+  gap: 0.4rem 0.75rem;
+  margin: 0.5rem 0 0;
+}
+
+.admin-check {
+  display: flex;
+  align-items: center;
+  gap: 0.45rem;
+  margin: 0;
+  font-size: 0.9rem;
+}
+
+.admin-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 0.45rem;
+}
+
+.admin-list li {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.55rem 0.85rem;
+  align-items: center;
+  padding: 0.65rem 0.75rem;
+  border: 1px solid var(--admin-line);
+  border-radius: 9px;
+  background: #fafcfd;
+}
+
+.admin-empty {
+  margin: 0.5rem 0 0;
+  color: var(--admin-muted);
+  font-size: 0.9rem;
+}
+
+.admin-backdrop {
+  display: none;
+}
+
+/* —— 登录 —— */
+.admin-login {
+  min-height: calc(100vh - 56px);
+  display: grid;
+  place-items: center;
+  padding: 2rem 1rem;
+  background:
+    radial-gradient(700px 360px at 15% 10%, rgba(58, 167, 214, 0.16), transparent 55%),
+    radial-gradient(560px 300px at 90% 80%, rgba(36, 134, 187, 0.12), transparent 50%),
+    var(--admin-work);
+}
+
+.admin-login__card {
+  width: min(420px, 100%);
+  background: var(--admin-panel);
+  border: 1px solid var(--admin-line);
+  border-radius: 16px;
+  padding: 1.6rem 1.5rem 1.45rem;
+  box-shadow: 0 18px 48px rgba(15, 30, 45, 0.08);
+}
+
+.admin-login__eyebrow {
+  margin: 0 0 0.35rem;
+  font-size: 0.72rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--admin-accent);
+  font-weight: 700;
+}
+
+.admin-login__title {
+  margin: 0 0 0.35rem;
+  font-family: var(--lanius-font-display);
+  font-size: 1.45rem;
+}
+
+.admin-login__hint {
+  margin: 0 0 1rem;
+  color: var(--admin-muted);
+  font-size: 0.88rem;
+  line-height: 1.45;
+}
+
+@media (min-width: 900px) {
+  .admin-top__meta {
+    display: inline;
+  }
+}
+
+@media (max-width: 860px) {
+  .admin-menu-btn {
+    display: inline-grid;
+    place-items: center;
+  }
+
+  .admin-shell {
+    grid-template-columns: 1fr;
+  }
+
+  .admin-side {
+    position: fixed;
+    top: 56px;
+    left: 0;
+    bottom: 0;
+    width: min(280px, 86vw);
+    z-index: 50;
+    transform: translateX(-105%);
+    transition: transform 0.2s ease;
+    box-shadow: 12px 0 32px rgba(0, 0, 0, 0.25);
+  }
+
+  .admin-root--nav-open .admin-side {
+    transform: translateX(0);
+  }
+
+  .admin-backdrop {
+    display: block;
+    position: fixed;
+    inset: 56px 0 0;
+    background: rgba(8, 14, 24, 0.45);
+    z-index: 45;
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity 0.2s ease;
+  }
+
+  .admin-root--nav-open .admin-backdrop {
+    opacity: 1;
+    pointer-events: auto;
+  }
+}
diff --git a/apps/web/assets/css/anime.css b/apps/web/assets/css/anime.css
new file mode 100644
index 0000000..8691e85
--- /dev/null
+++ b/apps/web/assets/css/anime.css
@@ -0,0 +1,179 @@
+/**
+ * 公开站暖底 anime 主题（奶油底 + 珊瑚/天空点缀）。
+ * 在 `body.theme-anime` 下同步覆盖 `--lanius-*`，避免与暗色半成品 token 混用。
+ */
+:root {
+  --anime-ink: #2a3142;
+  --anime-muted: #6b7385;
+  --anime-cream: #fff8f2;
+  --anime-panel: rgba(255, 255, 255, 0.92);
+  --anime-line: rgba(196, 168, 148, 0.45);
+  --anime-sky: #4eb7e8;
+  --anime-sky-deep: #2f8fc4;
+  --anime-coral: #ff7a6e;
+  --anime-peach: #ffb38a;
+  --anime-mint: #5fd0b0;
+  --anime-gold: #f0b429;
+  --anime-shadow: 0 14px 40px rgba(62, 78, 110, 0.1);
+  --anime-radius: 22px;
+  --anime-font-display: 'Zen Maru Gothic', 'Noto Sans SC', sans-serif;
+  --anime-font-body: 'Noto Sans SC', 'Source Sans 3', sans-serif;
+}
+
+/* 首屏脚本标记：在 body class 挂上前先铺暖底，避免闪成系统暗色 */
+html.theme-anime-boot {
+  color-scheme: light;
+  background: #fff8f2;
+}
+
+body.theme-anime {
+  color-scheme: light;
+  color: var(--anime-ink);
+  font-family: var(--anime-font-body);
+
+  /* 与 tokens.css 对齐的暖色板，公开站唯一真相源 */
+  --lanius-void: #fff8f2;
+  --lanius-panel: #ffffff;
+  --lanius-panel-raised: #fff4eb;
+  --lanius-border: #e4d5c8;
+  --lanius-border-bright: #c9b8a8;
+  --lanius-text: #2a3142;
+  --lanius-text-muted: #6b7385;
+  --lanius-accent: #4eb7e8;
+  --lanius-accent-dim: #2f8fc4;
+  --lanius-warn: #f0b429;
+  --lanius-danger: #ff7a6e;
+  --lanius-success: #5fd0b0;
+  --lanius-brand: #2a3142;
+  --lanius-highlight: #ff7a6e;
+  --lanius-bar-attack: #4eb7e8;
+  --lanius-bar-defend: #ffb38a;
+
+  background:
+    radial-gradient(920px 520px at 8% -10%, rgba(78, 183, 232, 0.28), transparent 55%),
+    radial-gradient(780px 460px at 96% 4%, rgba(255, 122, 110, 0.22), transparent 52%),
+    radial-gradient(640px 420px at 50% 110%, rgba(95, 208, 176, 0.18), transparent 55%),
+    linear-gradient(180deg, #fffaf5 0%, var(--anime-cream) 40%, #fff1e8 100%);
+  background-attachment: fixed;
+}
+
+/* 公开站忽略 html.theme-dark，防止系统暗色把背景打成冷灰蓝 */
+html.theme-dark body.theme-anime {
+  color: var(--anime-ink);
+  background:
+    radial-gradient(920px 520px at 8% -10%, rgba(78, 183, 232, 0.28), transparent 55%),
+    radial-gradient(780px 460px at 96% 4%, rgba(255, 122, 110, 0.22), transparent 52%),
+    radial-gradient(640px 420px at 50% 110%, rgba(95, 208, 176, 0.18), transparent 55%),
+    linear-gradient(180deg, #fffaf5 0%, var(--anime-cream) 40%, #fff1e8 100%);
+}
+
+@media (max-width: 720px) {
+  body.theme-anime {
+    background-attachment: scroll;
+  }
+}
+
+body.theme-anime .shell__bar {
+  background: rgba(255, 250, 245, 0.92);
+  border-bottom-color: var(--anime-line);
+  box-shadow: 0 8px 24px rgba(62, 78, 110, 0.06);
+}
+
+body.theme-anime .shell__float {
+  background: rgba(255, 250, 245, 0.96);
+  border-color: var(--anime-line);
+  box-shadow: 0 18px 44px rgba(62, 78, 110, 0.14);
+}
+
+body.theme-anime .shell__content {
+  background: transparent;
+  color: var(--anime-ink);
+}
+
+body.theme-anime .shell__brand {
+  font-family: var(--anime-font-display);
+  color: var(--anime-ink);
+}
+
+body.theme-anime .shell__mark {
+  background: linear-gradient(145deg, var(--anime-coral), var(--anime-peach));
+  border-radius: 12px;
+}
+
+body.theme-anime .shell__nav a.router-link-active {
+  color: var(--anime-sky-deep);
+}
+
+body.theme-anime .shell__link--active {
+  background: rgba(78, 183, 232, 0.14);
+  color: var(--anime-sky-deep);
+}
