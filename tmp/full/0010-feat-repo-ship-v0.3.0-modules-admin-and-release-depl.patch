+      }
+      if (url.endsWith('ExportResources.json')) {
+        return new Response(
+          JSON.stringify({
+            '/Lotus/Types/Recipes/Weapons/WeaponParts/DeraVandalStock': {
+              icon: '/Lotus/Interface/Icons/StoreIcons/Resources/CraftingComponents/GenericGunStock.png',
+            },
+          }),
+        );
+      }
