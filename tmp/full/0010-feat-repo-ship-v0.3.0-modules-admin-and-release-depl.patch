+    );
+    expect(hit?.iconPath).toContain('GenericGunStock.png');
+    expect(hit?.iconUrl).toContain('content.warframe.com/PublicExport');
+    expect(hit?.iconUrl).toContain('!00_hash');
+
+    const viaStore = lookupItemIcon(
