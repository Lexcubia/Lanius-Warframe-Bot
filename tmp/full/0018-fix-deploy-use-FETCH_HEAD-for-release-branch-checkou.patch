From 1172777a891279bad295140ec40b9f25b1c45332 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 02:07:07 +0800
Subject: [PATCH 18/45] fix(deploy): use FETCH_HEAD for release branch checkout
 on server

---
 .github/workflows/deploy-release.yml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/deploy-release.yml b/.github/workflows/deploy-release.yml
index a852b22..5e1a6ec 100644
--- a/.github/workflows/deploy-release.yml
+++ b/.github/workflows/deploy-release.yml
@@ -52,8 +52,8 @@ jobs:
             TAG='${{ steps.meta.outputs.tag }}'
             cd "${REPO_ROOT}"
             git fetch origin release --force
-            git checkout -B release "origin/release" || git checkout release
-            git reset --hard "origin/release" || true
+            git checkout -B release FETCH_HEAD
+            git reset --hard FETCH_HEAD
             cd "${DEPLOY_DIR}"
             export IMAGE_TAG="${TAG}"
             export GHCR_IMAGE_PREFIX='ghcr.io/lexcubia/lanius-warframe-bot'
-- 
