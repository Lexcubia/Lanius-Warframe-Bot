From c1ede957bb733f8ff66ff8a9e84a409789bf804a Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 02:30:06 +0800
Subject: [PATCH 22/45] fix(deploy): use --no-deps and remove depends_on health
 gate

---
 deploy/docker-compose.app.yml | 2 +-
 deploy/update-image.sh        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/deploy/docker-compose.app.yml b/deploy/docker-compose.app.yml
index c37b877..4debf08 100644
--- a/deploy/docker-compose.app.yml
+++ b/deploy/docker-compose.app.yml
@@ -63,7 +63,7 @@ services:
       - caddy_config:/config
     depends_on:
       lanius-app:
-        condition: service_healthy
+        condition: service_started
 
 volumes:
   caddy_data:
diff --git a/deploy/update-image.sh b/deploy/update-image.sh
index c58186c..edef608 100644
--- a/deploy/update-image.sh
+++ b/deploy/update-image.sh
@@ -25,6 +25,6 @@ fi
 
 echo "pulling IMAGE_TAG=${TAG} with ${COMPOSE_FILE}"
 docker compose -f "${COMPOSE_FILE}" pull
-docker compose -f "${COMPOSE_FILE}" up -d
+docker compose -f "${COMPOSE_FILE}" up -d --no-deps --remove-orphans
 docker compose -f "${COMPOSE_FILE}" ps
 echo "done"
-- 
2.51.2.windows.1

