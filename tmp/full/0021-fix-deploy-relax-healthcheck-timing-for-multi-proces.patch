From 5661babdc4debc78b65ea3f3e3ecf4d7e085fe22 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 02:21:40 +0800
Subject: [PATCH 21/45] fix(deploy): relax healthcheck timing for multi-process
 startup

---
 deploy/docker-compose.app.yml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/deploy/docker-compose.app.yml b/deploy/docker-compose.app.yml
index 15b31ba..c37b877 100644
--- a/deploy/docker-compose.app.yml
+++ b/deploy/docker-compose.app.yml
@@ -44,10 +44,10 @@ services:
           '-e',
           "fetch('http://127.0.0.1:8787/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
         ]
-      interval: 30s
-      timeout: 5s
-      retries: 3
-      start_period: 45s
+      interval: 15s
+      timeout: 10s
+      retries: 6
+      start_period: 90s
 
   caddy:
     image: caddy:2.9-alpine
-- 
2.51.2.windows.1

