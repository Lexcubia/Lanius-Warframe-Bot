From 7a867639a9f7163b52ab95b73247cc2825388c86 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 01:49:02 +0800
Subject: [PATCH 16/45] fix(bot): include @lanius/config package in Dockerfile
 build

---
 apps/bot/Dockerfile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/apps/bot/Dockerfile b/apps/bot/Dockerfile
index de1039f..a0bbe7c 100644
--- a/apps/bot/Dockerfile
+++ b/apps/bot/Dockerfile
@@ -14,6 +14,7 @@ FROM base AS build
 COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
 COPY apps/bot/package.json apps/bot/
 COPY packages/core/package.json packages/core/
+COPY packages/config/package.json packages/config/
 COPY packages/api/package.json packages/api/
 COPY packages/qq-official/package.json packages/qq-official/
 COPY packages/render/package.json packages/render/
@@ -22,6 +23,7 @@ RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
     pnpm install --frozen-lockfile --filter @lanius/bot...
 COPY apps/bot apps/bot
 COPY packages/core packages/core
+COPY packages/config packages/config
 COPY packages/api packages/api
 COPY packages/qq-official packages/qq-official
 COPY packages/render packages/render
