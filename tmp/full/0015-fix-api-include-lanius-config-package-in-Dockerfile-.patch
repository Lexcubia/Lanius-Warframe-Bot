From 8a15952291b83e5a614fdf777fa3887096e0078c Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 01:46:37 +0800
Subject: [PATCH 15/45] fix(api): include @lanius/config package in Dockerfile
 build

---
 apps/api/Dockerfile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/apps/api/Dockerfile b/apps/api/Dockerfile
index db36eee..5dc7582 100644
--- a/apps/api/Dockerfile
+++ b/apps/api/Dockerfile
@@ -15,10 +15,12 @@ RUN apt-get update \
 COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
 COPY apps/api/package.json apps/api/
 COPY packages/core/package.json packages/core/
+COPY packages/config/package.json packages/config/
 RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
     pnpm install --frozen-lockfile --filter @lanius/server...
 COPY apps/api apps/api
 COPY packages/core packages/core
+COPY packages/config packages/config
 COPY config/default config/default
 COPY scripts/prepare-runtime-package.mjs scripts/prepare-runtime-package.mjs
 RUN pnpm --filter @lanius/server build \
-- 
2.51.2.windows.1

