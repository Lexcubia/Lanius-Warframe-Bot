From a9db166f12a4c700889c96a54f5cdba1c41928f0 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Sun, 11 Oct 2026 19:05:08 +0800
Subject: [PATCH 09/45] fix(deploy): scp bot files and use DaoCloud/npmmirror
 when gitHub is unreachable

---
 .../workflows/prepare-playwright-deploy.yml   | 64 +++++++++++++++----
 deploy/prepare-playwright.sh                  | 12 ++--
 2 files changed, 58 insertions(+), 18 deletions(-)

diff --git a/.github/workflows/prepare-playwright-deploy.yml b/.github/workflows/prepare-playwright-deploy.yml
index fa5eb74..d8186c1 100644
--- a/.github/workflows/prepare-playwright-deploy.yml
+++ b/.github/workflows/prepare-playwright-deploy.yml
@@ -1,4 +1,5 @@
-# 服务器：镜像预装 Playwright Chromium → compose build/up（供 QQ 出图联调）
+# 服务器：镜像预装 Playwright → compose build/up
+# 规避机房直连 github.com 失败：Actions checkout + scp 关键文件，git 用镜像重试。
 
 name: Prepare Playwright and deploy
 
@@ -11,7 +12,7 @@ on:
         default: ''
         type: string
       git_ref:
-        description: '检出的 git ref（分支/tag）'
+        description: '优先用 git 镜像检出的 ref；失败则依赖 scp 的 Dockerfile/脚本'
         required: false
         default: 'develop'
         type: string
@@ -27,6 +28,22 @@ jobs:
     timeout-minutes: 90
     environment: production
     steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.git_ref }}
+
+      - name: SCP deploy/bot files to server
+        uses: appleboy/scp-action@v0.1.7
+        with:
+          host: ${{ secrets.DEPLOY_HOST }}
+          username: ${{ secrets.DEPLOY_USER }}
+          key: ${{ secrets.DEPLOY_SSH_KEY }}
+          port: ${{ secrets.DEPLOY_PORT }}
+          source: 'deploy/prepare-playwright.sh,deploy/docker-compose.yml,apps/bot/Dockerfile'
+          target: '/opt/lanius/repo'
+          overwrite: true
+
       - name: Prepare Playwright (mirror) and deploy over SSH
         uses: appleboy/ssh-action@v1.2.0
         with:
@@ -44,19 +61,39 @@ jobs:
             SERVICE='${{ inputs.service }}'
             test -f "${SECRETS_FILE}" || { echo "missing ${SECRETS_FILE}"; exit 1; }
             cd "${REPO_ROOT}"
-            git fetch --tags --force origin
-            git fetch origin "${REF}"
-            git checkout -f "FETCH_HEAD"
-            git log -1 --oneline
-            # 国内镜像预装 Chromium（已装同版本则跳过）
+            chmod +x deploy/prepare-playwright.sh || true
+
+            # 尽量同步代码；github.com 失败时换镜像（不阻断后续：scp 已覆盖 Dockerfile/脚本）
+            fetch_ok=0
+            for remote in \
+              "https://github.com/Lexcubia/Lanius-Warframe-Bot.git" \
+              "https://gitclone.com/github.com/Lexcubia/Lanius-Warframe-Bot.git" \
+              "https://ghfast.top/https://github.com/Lexcubia/Lanius-Warframe-Bot.git"
+            do
+              echo "[lanius] trying git fetch via ${remote}"
+              if git fetch --tags --force "${remote}" "${REF}" 2>/tmp/lanius-git-fetch.err; then
+                git checkout -f FETCH_HEAD || git checkout -f "tags/${REF}" || true
+                fetch_ok=1
+                break
+              fi
+              cat /tmp/lanius-git-fetch.err || true
+            done
+            if [ "${fetch_ok}" -eq 0 ]; then
+              echo "[lanius] WARN: git fetch failed; continue with on-disk tree + scp'd files"
+            fi
+            git log -1 --oneline || true
+
             export PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST:-https://npmmirror.com/mirrors/playwright}"
             export NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}"
+            export LANIUS_PLAYWRIGHT_NODE_IMAGE="${LANIUS_PLAYWRIGHT_NODE_IMAGE:-docker.m.daocloud.io/library/node:22-bookworm}"
             bash "${REPO_ROOT}/deploy/prepare-playwright.sh"
+
             PLAYWRIGHT_DIR="${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}"
-            test -n "$(compgen -G "${PLAYWRIGHT_DIR}/chromium-*" || true)" || {
+            if ! compgen -G "${PLAYWRIGHT_DIR}/chromium-*" > /dev/null; then
               echo "prepare-playwright.sh finished but no chromium-* under ${PLAYWRIGHT_DIR}"
               exit 1
-            }
+            fi
+
             cd "${DEPLOY_DIR}"
             if [ -f .env ]; then
               grep -q '^LANIUS_CONFIG_FILE=' .env || echo "LANIUS_CONFIG_FILE=${SECRETS_FILE}" >> .env
@@ -66,15 +103,18 @@ jobs:
             fi
             export LANIUS_PLAYWRIGHT_DIR="${PLAYWRIGHT_DIR}"
             export GHCR_IMAGE_PREFIX='ghcr.io/lexcubia/lanius-warframe-bot'
+
+            # bot 用源码 build（Dockerfile 已 scp）；其余服务尽量 up 现有镜像
             if [ -n "${SERVICE}" ]; then
               docker compose build "${SERVICE}"
               docker compose up -d "${SERVICE}"
             else
-              docker compose build
+              docker compose build bot
+              docker compose build api web || true
               docker compose up -d
             fi
             docker compose ps
-            sleep 20
-            docker compose logs bot --tail 80 || true
+            sleep 25
+            docker compose logs bot --tail 100 || true
             curl -fsS "https://${DOMAIN:-warframe.lexcubia.com}/api/lanius/v1/health" || \
               curl -fsS "http://127.0.0.1/api/lanius/v1/health"
diff --git a/deploy/prepare-playwright.sh b/deploy/prepare-playwright.sh
index 03921b7..2dd7ca9 100644
--- a/deploy/prepare-playwright.sh
+++ b/deploy/prepare-playwright.sh
@@ -1,19 +1,17 @@
 #!/usr/bin/env bash
 # 在生产机预装 Playwright Chromium 到宿主机目录，供 bot 容器只读挂载。
-# 默认走 npmmirror，避免卡在官方 CDN / mcr.microsoft.com。
+# 默认走 npmmirror + DaoCloud Node 镜像，避免卡在官方 CDN / Docker Hub。
 #
 # 用法：
 #   bash /opt/lanius/repo/deploy/prepare-playwright.sh
-#   LANIUS_PLAYWRIGHT_DIR=/opt/lanius/ms-playwright PLAYWRIGHT_VERSION=1.51.0 bash deploy/prepare-playwright.sh
 
 set -euo pipefail
 
 DIR="${LANIUS_PLAYWRIGHT_DIR:-/opt/lanius/ms-playwright}"
 PW_VERSION="${PLAYWRIGHT_VERSION:-1.51.0}"
-# 国内镜像：浏览器二进制（可覆盖）
 PW_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST:-https://npmmirror.com/mirrors/playwright}"
-# Node 基础镜像（可换成国内 registry 上的 node:22-bookworm）
-NODE_IMAGE="${LANIUS_PLAYWRIGHT_NODE_IMAGE:-node:22-bookworm}"
+# DaoCloud 代理 Docker Hub 上的官方 node 镜像
+NODE_IMAGE="${LANIUS_PLAYWRIGHT_NODE_IMAGE:-docker.m.daocloud.io/library/node:22-bookworm}"
 MARKER="${DIR}/.lanius-playwright-version"
 
 echo "[lanius] Playwright prep → ${DIR} (playwright@${PW_VERSION})"
@@ -30,6 +28,9 @@ if [[ -f "${MARKER}" ]] && [[ "$(cat "${MARKER}")" == "${PW_VERSION}" ]]; then
   fi
 fi
 
+echo "[lanius] pulling node image (may use mirror)…"
+docker pull "${NODE_IMAGE}"
+
 echo "[lanius] downloading Chromium via docker + npmmirror…"
 docker run --rm \
   -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
@@ -40,7 +41,6 @@ docker run --rm \
   /bin/bash -lc "
     set -euo pipefail
     npm install -g \"playwright@${PW_VERSION}\"
-    # 系统依赖装在 bot 运行镜像里；此处只拉浏览器二进制
     playwright install chromium
   "
 
-- 
2.51.2.windows.1

