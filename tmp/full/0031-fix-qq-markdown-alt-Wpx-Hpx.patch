stripHttpUrls 占位时勿改写成 ![img]，否则移动端只显示 [img]。
---
 packages/qq-official/src/client.test.ts | 7 +++++--
 packages/qq-official/src/client.ts      | 8 ++++----
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/packages/qq-official/src/client.test.ts b/packages/qq-official/src/client.test.ts
index cf0b721..adc59ef 100644
--- a/packages/qq-official/src/client.test.ts
+++ b/packages/qq-official/src/client.test.ts
@@ -136,8 +136,11 @@ describe('QqOfficialClient.sendMarkdown', () => {
     const body = JSON.parse(String(sendInit.body)) as {
       markdown: { content: string };
     };
-    // 图片语法内 URL 保留；裸链被剥除
-    expect(body.markdown.content).toContain('](https://cos.lexcubia.com/lanius/cards/a.png)');
+    // 图片语法内 URL 与尺寸标注保留；裸链被剥除
+    expect(body.markdown.content).toContain(
+      '![虚空裂隙 #640px #534px](https://cos.lexcubia.com/lanius/cards/a.png)',
+    );
+    expect(body.markdown.content).not.toContain('![img](');
     expect(body.markdown.content).not.toContain('https://example.com/x');
   });
 });
diff --git a/packages/qq-official/src/client.ts b/packages/qq-official/src/client.ts
index a3d80e7..0463939 100644
--- a/packages/qq-official/src/client.ts
+++ b/packages/qq-official/src/client.ts
@@ -366,13 +366,13 @@ function filesPath(target: QqSendTarget): string {
  */
 function stripHttpUrls(content: string): string {
   // 保留 markdown 图片语法 `![alt](url)` 内的 URL（嵌图需要公网链接），
-  // 其余裸链剥除（群场景限制外链）。
+  // 其余裸链剥除（群场景限制外链）。占位时必须保留原始 alt（含 `#Wpx #Hpx` 尺寸标注）。
   const imageUrls: string[] = [];
   const placeholdered = content.replace(
-    /!\[[^\]]*\]\((https?:\/\/[^)\s]+)\)/gi,
-    (_m, url: string) => {
+    /!\[([^\]]*)\]\((https?:\/\/[^)\s]+)\)/gi,
+    (_m, alt: string, url: string) => {
       imageUrls.push(url);
-      return `![img](__LANIUS_IMG_${imageUrls.length - 1}__)`;
+      return `![${alt}](__LANIUS_IMG_${imageUrls.length - 1}__)`;
     },
   );
   const stripped = placeholdered.replace(/https?:\/\/\S+/gi, '').replace(/[ \t]+\n/g, '\n');
