From f397104f0a2ea3a972fdbf24c9c526381707f885 Mon Sep 17 00:00:00 2001
From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 01:33:20 +0800
Subject: [PATCH 13/45] fix(bot): handle empty lines in toFissureMarkdown for
 TS strict null check

---
 apps/bot/src/pipeline/handle-command.ts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/apps/bot/src/pipeline/handle-command.ts b/apps/bot/src/pipeline/handle-command.ts
index 7357eb0..c1d6223 100644
--- a/apps/bot/src/pipeline/handle-command.ts
+++ b/apps/bot/src/pipeline/handle-command.ts
@@ -491,10 +491,11 @@ async function replyFissuresWithShortcuts(options: {
  */
 function toFissureMarkdown(text: string): string {
   const lines = text.split('\n');
-  if (lines.length === 0) {
+  const head = lines[0];
+  if (!head) {
     return text;
   }
-  const [head, ...rest] = lines;
+  const rest = lines.slice(1);
   return [`**${head.replace(/^\*+|\*+$/g, '').trim()}**`, ...rest].join('\n');
 }
 
