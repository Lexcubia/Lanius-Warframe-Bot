From: Lexcubia <lexcubia@gmail.com>
Date: Mon, 12 Oct 2026 03:54:33 +0800
Subject: [PATCH 28/45] =?UTF-8?q?fix(bot):=20tsup=20=E5=A4=96=E8=81=94=20C?=
 =?UTF-8?q?JS=20=E4=BE=9D=E8=B5=96=20yaml=EF=BC=8C=E4=BF=AE=E5=A4=8D=20ESM?=
 =?UTF-8?q?=20=E4=BA=A7=E7=89=A9=20Dynamic=20require=20=E5=B4=A9=E6=BA=83?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- bot/tsup.config.ts: external 增加 yaml，target 对齐 node22；
  此前 @lanius/config 的 CJS 依赖 yaml 被卷入 ESM 产物，
  运行时触发 Dynamic require of "process" is not supported
- prepare-runtime-package.mjs: BOT_RUNTIME_EXTRAS 补 yaml，
  确保 Docker runner npm install 后 node_modules 存在该外联依赖；
  顶部补 node 全局注释，修复 eslint no-undef（既有配置缺陷）
---
 apps/bot/tsup.config.ts             | 5 ++++-
 scripts/prepare-runtime-package.mjs | 3 +++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/apps/bot/tsup.config.ts b/apps/bot/tsup.config.ts
index ee5c23d..555218c 100644
--- a/apps/bot/tsup.config.ts
+++ b/apps/bot/tsup.config.ts
@@ -8,7 +8,7 @@ export default defineConfig({
   entry: ['src/index.ts'],
   format: ['esm'],
   platform: 'node',
-  target: 'node20',
+  target: 'node22',
   clean: true,
   sourcemap: true,
   noExternal: [/^@lanius\//],
@@ -22,5 +22,8 @@ export default defineConfig({
     'vite',
     '@vitejs/plugin-vue',
     'vue',
+    // CJS 第三方依赖：保持 external，避免被卷入 ESM 产物后
+    // 触发 "Dynamic require of \"process\" is not supported"（yaml 等）
+    'yaml',
   ],
 });
diff --git a/scripts/prepare-runtime-package.mjs b/scripts/prepare-runtime-package.mjs
index 1500e2c..0c74cb1 100644
--- a/scripts/prepare-runtime-package.mjs
+++ b/scripts/prepare-runtime-package.mjs
@@ -2,6 +2,7 @@
  * 为 Docker runner 阶段生成可独立安装的 package.json（外部 npm 依赖）。
  * 用法：`node scripts/prepare-runtime-package.mjs api|bot <outDir>`
  */
+/* global process, console */
 import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
 import { dirname, resolve } from 'node:path';
 import { fileURLToPath } from 'node:url';
@@ -18,6 +19,8 @@ const BOT_RUNTIME_EXTRAS = {
   '@fontsource/noto-sans-sc': '^5.2.5',
   '@fontsource/rajdhani': '^5.2.5',
   playwright: '^1.51.0',
+  // tsup external 的 CJS 依赖（来自 @lanius/config），运行时需存在于 node_modules
+  yaml: '^2.6.1',
 };
 
 /**
