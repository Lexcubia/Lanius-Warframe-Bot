---
 .github/workflows/dump-qq-panels.yml | 81 ++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 .github/workflows/dump-qq-panels.yml

diff --git a/.github/workflows/dump-qq-panels.yml b/.github/workflows/dump-qq-panels.yml
new file mode 100644
index 0000000..a9694a4
--- /dev/null
+++ b/.github/workflows/dump-qq-panels.yml
@@ -0,0 +1,81 @@
+# 在生产机用 bot 配置调用 GET /v2/panels，打印原始 JSON（排查列表解析）。
+
+name: Dump QQ panels
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  dump:
+    name: dump-qq-panels
+    if: github.repository == 'Lexcubia/Lanius-Warframe-Bot'
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    environment: production
+    steps:
+      - name: Dump panels over SSH
+        uses: appleboy/ssh-action@v1.2.0
+        with:
+          host: ${{ secrets.DEPLOY_HOST }}
+          username: ${{ secrets.DEPLOY_USER }}
+          key: ${{ secrets.DEPLOY_SSH_KEY }}
+          port: ${{ secrets.DEPLOY_PORT }}
+          command_timeout: 5m
+          script: |
+            set -euo pipefail
+            SECRETS_FILE="${LANIUS_SECRETS_FILE:-/opt/lanius/secrets/config.local.yaml}"
+            python3 <<'PY'
+            import json, re, ssl, urllib.request
+            from pathlib import Path
+
+            text = Path("/opt/lanius/secrets/config.local.yaml").read_text(encoding="utf-8")
+
+            def grab(key: str) -> str:
+                m = re.search(rf"(?:^|\n)\s*{key}:\s*[\"']?([^\n\"']+)", text)
+                if not m:
+                    raise SystemExit(f"missing {key}")
+                return m.group(1).strip()
+
+            app_id = grab("appId")
+            secret = grab("appSecret")
+            ctx = ssl.create_default_context()
+
+            def post_json(url: str, body: dict, headers=None):
+                req = urllib.request.Request(
+                    url,
+                    data=json.dumps(body).encode(),
+                    headers={"Content-Type": "application/json", **(headers or {})},
+                    method="POST",
+                )
+                with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
+                    return json.loads(resp.read().decode())
+
+            def get_json(url: str, token: str):
+                req = urllib.request.Request(
+                    url,
+                    headers={
+                        "Authorization": f"QQBot {token}",
+                        "Content-Type": "application/json; charset=utf-8",
+                    },
+                    method="GET",
+                )
+                with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
+                    raw = resp.read().decode()
+                    print("HTTP", resp.status, url)
+                    print(raw[:4000])
+                    return json.loads(raw) if raw else {}
+
+            tok = post_json(
+                "https://api.bot.qq.com/app/getAppAccessToken",
+                {"appId": app_id, "clientSecret": secret},
+            )
+            token = tok.get("access_token")
+            if not token:
+                raise SystemExit(f"token failed: {tok}")
+            for scope in ("c2c", "group", "channel", "dm"):
+                print("=" * 60, scope)
+                get_json(f"https://api.bot.qq.com/v2/panels?scope={scope}&limit=50", token)
+            PY
