+#!/usr/bin/env bash
+# Lanius 鏇存柊鑴氭湰锛堢儹鍚姩妯″紡锛?+# 鍦ㄦ湇鍔″櫒涓婁互 root 鎴栨湁 sudo 鐨勭敤鎴锋墽琛岋細bash /opt/lanius/repo/deploy/update.sh
+#
+# 娴佺▼锛歡it pull 鈫?pnpm install锛堜緷璧栨湁鍙樺寲鏃讹級鈫?閲嶅缓 web锛圢uxt 蹇呴』鏋勫缓锛夆啋 閲嶅惎 lanius.target
+# api/bot 涓?tsx 鐩磋窇婧愮爜锛屾棤闇€鏋勫缓锛泈eb 涓?Nuxt锛屽繀椤?build 鍑?.output銆?+
+set -euo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+BRANCH="${LANIUS_UPDATE_BRANCH:-develop}"
+
+echo "[lanius-update] repo=$REPO_ROOT branch=$BRANCH"
+
+cd "$REPO_ROOT"
+
+# 1. 鎷夊彇鏈€鏂颁唬鐮?+echo "[lanius-update] git fetch + reset to origin/$BRANCH"
+git fetch origin "$BRANCH"
+git reset --hard "origin/$BRANCH"
+
+# 2. 渚濊禆锛坙ockfile 鍙樺寲鎵嶉噸瑁咃紝鐪佹椂闂达級
+if git diff --name-only HEAD@{1} HEAD 2>/dev/null | grep -q 'pnpm-lock.yaml'; then
+  echo "[lanius-update] lockfile changed, pnpm install"
+  pnpm install --frozen-lockfile
+else
+  echo "[lanius-update] lockfile unchanged, skip install"
+fi
+
+# 3. 閲嶅缓 web锛圢uxt 蹇呴』鏋勫缓锛沘pi/bot 璧?tsx 婧愮爜鏃犻渶鏋勫缓锛?+echo "[lanius-update] build web (nuxt)"
+pnpm --filter @lanius/web build
+
+# 4. 閲嶅惎鏈嶅姟
+echo "[lanius-update] restart lanius.target"
+systemctl restart lanius.target
+
+echo "[lanius-update] done"
