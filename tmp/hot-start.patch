diff --git a/packages/core/src/update-check.ts b/packages/core/src/update-check.ts
new file mode 100644
index 0000000..bda9e9e
--- /dev/null
+++ b/packages/core/src/update-check.ts
@@ -0,0 +1,82 @@
+import { execSync } from 'node:child_process';
+
+/**
+ * 鍚姩鏃舵洿鏂版鏌ョ粨鏋溿€?+ */
+export type UpdateCheckResult = {
+  /** 鏄惁鏈夊彲鐢ㄦ洿鏂?*/
+  hasUpdate: boolean;
+  /** 鏈湴褰撳墠 commit锛堢煭锛?*/
+  localCommit: string;
+  /** 杩滅▼鏈€鏂?commit锛堢煭锛夛紱妫€鏌ュけ璐ユ椂涓虹┖ */
+  remoteCommit: string;
+  /** 钀藉悗杩滅▼鐨勬彁浜ゆ暟 */
+  behind: number;
+  /** 妫€鏌ュけ璐ュ師鍥狅紙鏃犳洿鏂版垨澶辫触鏃朵负 undefined锛?*/
+  error?: string;
+};
+
+/**
+ * 鍚姩鏃舵鏌?git 浠撳簱鏄惁鏈夎繙绋嬫洿鏂帮紙涓嶆媺鍙栵紝浠呭姣旓級銆?+ * 閫氳繃 `git fetch` + `git rev-list` 瀹炵幇锛涢潪 git 浠撳簱鎴栫綉缁滃け璐ユ椂闈欓粯闄嶇骇銆?+ *
+ * @param repoRoot - 浠撳簱鏍圭洰褰曠粷瀵硅矾寰?+ * @param branch - 璺熻釜鍒嗘敮锛堥粯璁?develop锛?+ * @returns 鏇存柊妫€鏌ョ粨鏋?+ */
+export function checkForUpdate(repoRoot: string, branch = 'develop'): UpdateCheckResult {
+  const none: UpdateCheckResult = {
+    hasUpdate: false,
+    localCommit: '',
+    remoteCommit: '',
+    behind: 0,
+  };
+
+  try {
+    const localCommit = execSync('git rev-parse --short HEAD', {
+      cwd: repoRoot,
+      stdio: ['ignore', 'pipe', 'ignore'],
+    })
+      .toString()
+      .trim();
+
+    // fetch 杩滅▼鏈€鏂帮紙闈欓粯锛夛紝澶辫触涓嶅奖鍝嶅惎鍔?+    try {
+      execSync(`git fetch origin ${branch}`, {
+        cwd: repoRoot,
+        stdio: ['ignore', 'pipe', 'ignore'],
+        timeout: 15000,
+      });
+    } catch {
+      return { ...none, localCommit, error: 'fetch_failed' };
+    }
+
+    const remoteCommit = execSync(`git rev-parse --short origin/${branch}`, {
+      cwd: repoRoot,
+      stdio: ['ignore', 'pipe', 'ignore'],
+    })
+      .toString()
+      .trim();
+
+    const behind = Number(
+      execSync(`git rev-list --count HEAD..origin/${branch}`, {
+        cwd: repoRoot,
+        stdio: ['ignore', 'pipe', 'ignore'],
+      })
+        .toString()
+        .trim(),
+    );
+
+    return {
+      hasUpdate: behind > 0,
+      localCommit,
+      remoteCommit,
+      behind,
+    };
+  } catch (error) {
+    return {
+      ...none,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
